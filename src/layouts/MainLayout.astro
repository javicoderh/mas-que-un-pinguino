---
import FooterBlock from "../components/ui/FooterBlock.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import FloatingCTA from "../components/ui/FloatingCTA.astro";
import FloatingSignatureCounter from "../components/ui/FloatingSignatureCounter.astro";
import { campaignConfig } from "../content/campaign";
import { analyticsFormNames, gaEventNames, gaMeasurementId, isGaEnabled } from "../lib/analytics";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  hideFloatingCta?: boolean;
  robots?: string;
  keywords?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbItems?: Array<{ name: string; path: string }>;
  pageType?: "WebPage" | "AboutPage" | "CollectionPage" | "FAQPage" | "ContactPage" | "Article";
  socialImage?: string;
  socialImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = campaignConfig.site.title,
  description = campaignConfig.site.description,
  path = "/",
  hideFloatingCta = false,
  robots = "index,follow",
  keywords = [],
  schema,
  breadcrumbItems = [],
  pageType = "WebPage",
  socialImage,
  socialImageAlt = `Imagen principal de ${campaignConfig.site.name}`,
  publishedTime,
  modifiedTime
} = Astro.props;

const canonical = new URL(path, campaignConfig.site.siteUrl).toString();
const theme = campaignConfig.theme.colors;
const socialImageUrl = new URL(socialImage ?? campaignConfig.assets.ogImage, campaignConfig.site.siteUrl).toString();
const socialImageFallbackUrl = new URL(campaignConfig.assets.logo, campaignConfig.site.siteUrl).toString();
const keywordContent = keywords.length > 0 ? keywords.join(", ") : undefined;
const ogType = pageType === "Article" ? "article" : "website";
const gaInitScript = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  window.gtag = gtag;
  gtag("js", new Date());
  gtag("config", ${JSON.stringify(gaMeasurementId)}, {
    page_title: ${JSON.stringify(title)},
    page_location: window.location.href,
    page_path: window.location.pathname + window.location.search,
    anonymize_ip: true,
    allow_google_signals: false,
    allow_ad_personalization_signals: false,
    send_page_view: true
  });

  window.trackGaEvent = (eventName, params = {}) => {
    if (typeof window.gtag !== "function") return;
    window.gtag("event", eventName, params);
  };
`;
const gaEventsScript = `
  const findTrackedElement = (target) =>
    target instanceof Element ? target.closest("[data-analytics-event]") : null;

  document.addEventListener("click", (event) => {
    const tracked = findTrackedElement(event.target);
    if (!tracked || typeof window.trackGaEvent !== "function") return;

    const analyticsEvent = tracked.getAttribute("data-analytics-event");
    if (!analyticsEvent) return;

    const params = {
      link_text: tracked.getAttribute("data-analytics-label") || tracked.textContent?.trim() || "",
      link_url: tracked.getAttribute("href") || tracked.getAttribute("data-analytics-href") || "",
      link_context: tracked.getAttribute("data-analytics-context") || "",
      transport_type: "beacon"
    };

    window.trackGaEvent(analyticsEvent, params);
  }, { passive: true });

  window.addEventListener("signature:created", (event) => {
    if (typeof window.trackGaEvent !== "function") return;
    const detail = event instanceof CustomEvent ? event.detail || {} : {};
    window.trackGaEvent(${JSON.stringify(gaEventNames.signatureSubmitSuccess)}, {
      form_name: ${JSON.stringify(analyticsFormNames.campaignSignature)},
      page_path: window.location.pathname,
      submission_status: detail.status || "accepted",
      conversion_type: "signature_registered",
      ui_surface: detail.uiSurface || "signature_page",
      source_context: detail.sourceContext || "campaign_site",
      transport_type: "beacon"
    });
  });

  window.addEventListener("signature:error", (event) => {
    if (typeof window.trackGaEvent !== "function") return;
    const detail = event instanceof CustomEvent ? event.detail || {} : {};
    window.trackGaEvent(${JSON.stringify(gaEventNames.signatureSubmitError)}, {
      form_name: ${JSON.stringify(analyticsFormNames.campaignSignature)},
      page_path: window.location.pathname,
      error_type: detail.errorType || "unknown",
      transport_type: "beacon"
    });
  });
`;
const customStructuredData = Array.isArray(schema) ? schema : schema ? [schema] : [];
const breadcrumbStructuredData =
  breadcrumbItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbItems.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: new URL(item.path, campaignConfig.site.siteUrl).toString()
        }))
      }
    : null;
const pageStructuredData = {
  "@context": "https://schema.org",
  "@type": pageType,
  name: title,
  description,
  url: canonical,
  inLanguage: campaignConfig.site.language,
  isPartOf: {
    "@type": "WebSite",
    name: campaignConfig.site.name,
    url: campaignConfig.site.siteUrl
  }
};
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: campaignConfig.site.name,
    url: campaignConfig.site.siteUrl,
    logo: new URL(campaignConfig.assets.logo, campaignConfig.site.siteUrl).toString(),
    email: campaignConfig.site.contactEmail,
    description: campaignConfig.site.description,
    sameAs: campaignConfig.socialLinks
      .map((item) => item.href)
      .filter((href) => /^https?:\/\//.test(href))
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: campaignConfig.site.name,
    url: campaignConfig.site.siteUrl,
    inLanguage: campaignConfig.site.language
  },
  pageStructuredData,
  ...(breadcrumbStructuredData ? [breadcrumbStructuredData] : []),
  ...customStructuredData
];
---

<!doctype html>
<html
  lang="es-CL"
  style={`
    --campaign-bg: ${theme.bg};
    --campaign-surface: ${theme.surface};
    --campaign-surface-strong: ${theme.surfaceStrong};
    --campaign-text: ${theme.text};
    --campaign-text-muted: ${theme.textMuted};
    --campaign-border: ${theme.border};
    --campaign-sky: ${theme.sky};
    --campaign-ocean: ${theme.ocean};
    --campaign-warm: ${theme.warm};
    --campaign-pink: ${theme.pink};
    --campaign-blush: ${theme.blush};
  `}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywordContent && <meta name="keywords" content={keywordContent} />}
    <meta name="author" content={campaignConfig.site.author} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={campaignConfig.site.themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={campaignConfig.site.language} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={campaignConfig.site.name} />
    <meta property="og:locale" content={campaignConfig.site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image" content={socialImageFallbackUrl} />
    <meta property="og:image:alt" content={`Logotipo de ${campaignConfig.site.name}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:url" content={canonical} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {isGaEnabled && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline set:html={gaInitScript} />
        <script is:inline set:html={gaEventsScript} />
      </>
    )}
  </head>
  <body>
    <a href="#contenido" class="focus-ring sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-campaign-warm focus:px-4 focus:py-2 focus:text-black">
      Saltar al contenido
    </a>
    <SiteHeader />
    <main id="contenido">
      <slot />
    </main>
    <FooterBlock />
    {!hideFloatingCta && <FloatingCTA href="/firma" label={campaignConfig.hero.buttons.floating} />}
    <div style="display: none;">
      <FloatingSignatureCounter />
    </div>
  </body>
</html>
