---
import { campaignConfig } from "../../content/campaign";
import logo from "../../assets/logo_pinguino_humboldt_circulo.png";

const { navigation, site } = campaignConfig;
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-black/75 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-6 lg:px-8">
    <a href="/" class="focus-ring inline-flex items-center gap-4 rounded-full">
      <img
        src={logo.src}
        alt={`Logo de ${site.name}`}
        class="h-14 w-14 rounded-full border border-white/16 bg-white/7 object-contain p-1.5 shadow-[0_12px_32px_rgba(0,0,0,0.28)]"
      />
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-campaign-warm md:text-sm">Campaña ciudadana</p>
        <p class="text-base font-black text-white md:text-lg">{site.name}</p>
      </div>
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              data-analytics-event="navigation_click"
              data-analytics-label={item.label}
              data-analytics-context="site_header_desktop"
              class="focus-ring text-sm font-semibold text-white/88 transition hover:text-campaign-warm"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <!-- Donar: oculto hasta activar Flow
      <a
        href="/#donar"
        data-analytics-event="cta_click"
        data-analytics-label="Donar"
        data-analytics-context="site_header_desktop"
        class="focus-ring button-text-outline inline-flex rounded-full border border-black/40 bg-campaign-warm px-5 py-3 text-sm font-black uppercase tracking-[0.08em] text-black shadow-[0_12px_36px_rgba(255,162,0,0.25),inset_0_1px_0_rgba(255,255,255,0.35)] transition hover:brightness-110"
      >
        Donar
      </a>
      -->
      <a
        href="/firma"
        data-analytics-event="cta_click"
        data-analytics-label="Firmar"
        data-analytics-context="site_header_desktop"
        class="focus-ring button-text-outline inline-flex rounded-full border border-black/55 bg-campaign-sky px-5 py-3 text-sm font-black uppercase tracking-[0.08em] text-white shadow-[0_18px_60px_rgba(56,182,255,0.3),inset_0_1px_0_rgba(255,255,255,0.24)] transition hover:border-black/65 hover:bg-[#63C6FF]"
      >
        Firmar
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary class="focus-ring flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border border-white/14 bg-white/6 text-white marker:hidden list-none transition hover:border-campaign-warm hover:text-campaign-warm">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current group-open:hidden">
          <path d="M4 7h16v2H4zm0 8h16v2H4zm0-4h16v2H4z"></path>
        </svg>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="hidden h-5 w-5 fill-current group-open:block">
          <path d="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6-5.6 5.6L5 17.6 10.6 12 5 6.4 6.4 5z"></path>
        </svg>
      </summary>

      <div class="absolute right-0 top-[calc(100%+0.75rem)] z-50 w-[min(88vw,22rem)] rounded-[1.75rem] border border-white/12 bg-black/92 p-5 shadow-[0_24px_80px_rgba(0,0,0,0.45)] backdrop-blur-xl">
        <nav aria-label="Principal móvil">
          <ul class="grid gap-2">
            {navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-analytics-event="navigation_click"
                  data-analytics-label={item.label}
                  data-analytics-context="site_header_mobile"
                  class="focus-ring block rounded-2xl border border-transparent px-4 py-3 text-sm font-semibold text-white transition hover:border-white/10 hover:bg-white/6 hover:text-campaign-warm"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="mt-4 grid gap-2">
          <!-- Donar: oculto hasta activar Flow
          <a
            href="/#donar"
            data-analytics-event="cta_click"
            data-analytics-label="Donar"
            data-analytics-context="site_header_mobile"
            class="focus-ring button-text-outline flex min-h-12 items-center justify-center rounded-full border border-black/40 bg-campaign-warm px-5 py-3 text-sm font-black uppercase tracking-[0.08em] text-black shadow-[0_12px_36px_rgba(255,162,0,0.25),inset_0_1px_0_rgba(255,255,255,0.35)]"
          >
            Donar
          </a>
          -->
          <a
            href="/firma"
            data-analytics-event="cta_click"
            data-analytics-label="Firmar ahora"
            data-analytics-context="site_header_mobile"
            class="focus-ring button-text-outline flex min-h-12 items-center justify-center rounded-full border border-black/55 bg-campaign-sky px-5 py-3 text-sm font-black uppercase tracking-[0.08em] text-white shadow-[0_18px_60px_rgba(56,182,255,0.3),inset_0_1px_0_rgba(255,255,255,0.24)]"
          >
            Firmar ahora
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
