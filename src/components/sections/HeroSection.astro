---
import { campaignConfig } from "../../content/campaign";
import logo from "../../assets/logo_pinguino_humboldt_circulo.png";
import pinguinosVideo from "../../assets/pinguinos.mp4";
import ButtonLink from "../ui/ButtonLink.astro";
import PenguinSmartGallery from "../campaign/PenguinSmartGallery.vue";
import Countdown from "../ui/Countdown.astro";
import Section from "../ui/Section.astro";

const { hero, dates, ecosystem } = campaignConfig;
---

<Section size="hero" class="overflow-visible" id="inicio">
  {hero.mode === "video" && hero.videoSrc ? (
    <video
      class="absolute inset-0 h-full w-full object-cover opacity-30"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source src={hero.videoSrc} />
    </video>
  ) : (
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(56,182,255,0.18),transparent_32%),radial-gradient(circle_at_80%_10%,rgba(255,162,209,0.18),transparent_22%),linear-gradient(180deg,rgba(0,151,178,0.06),transparent_55%)]"></div>
  )}
  <div data-hero-sentinel class="absolute inset-x-0 top-0 h-full" aria-hidden="true"></div>
  <div class="noise-overlay"></div>
  <div class="relative z-10 overflow-visible rounded-[2rem] border border-white/12 bg-black/20">
    <video
      data-hero-video
      class="absolute inset-0 h-full w-full object-cover opacity-75 md:opacity-44"
      autoplay
      muted
      playsinline
      aria-hidden="true"
    >
      <source src={pinguinosVideo} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,7,11,0.9)_0%,rgba(5,7,11,0.76)_42%,rgba(5,7,11,0.84)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_28%,rgba(255,255,255,0.08),transparent_18%),radial-gradient(circle_at_80%_20%,rgba(56,182,255,0.12),transparent_22%)]"></div>
    <button
      type="button"
      data-hero-video-play
      aria-label="Reproducir video con sonido"
      class="focus-ring absolute right-4 top-4 z-20 inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/24 bg-black/45 text-white shadow-[0_0_0_1px_rgba(255,255,255,0.05),0_12px_30px_rgba(0,0,0,0.32)] backdrop-blur-md transition duration-200 hover:-translate-y-0.5 hover:scale-105 hover:border-campaign-warm hover:bg-black/70 hover:text-campaign-warm md:right-6 md:top-6"
    >
      <span class="absolute inset-0 rounded-full animate-ping bg-white/8 [animation-duration:2.4s]"></span>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="relative z-10 h-6 w-6 fill-current">
        <path d="M8 6.5v11l9-5.5-9-5.5Z"></path>
      </svg>
    </button>

    <div class="relative grid items-start gap-8 p-4 pt-16 sm:p-6 sm:pt-18 md:p-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-12 lg:p-10">
      <div>
        <div class="mb-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center md:mb-10 md:gap-5">
          <div class="relative isolate flex h-28 w-28 items-center justify-center overflow-hidden rounded-full border border-white/16 bg-white/7 shadow-[0_28px_90px_rgba(0,0,0,0.45)] sm:h-32 sm:w-32 md:h-44 md:w-44">
            <div class="absolute inset-0 bg-[radial-gradient(circle,transparent_48%,rgba(5,7,11,0.18)_74%,rgba(5,7,11,0.55)_100%)]"></div>
            <img
              src={logo.src}
              alt="Logo circular de la campaña del pingüino de Humboldt"
              class="relative z-10 h-24 w-24 object-contain drop-shadow-[0_10px_24px_rgba(0,0,0,0.45)] sm:h-28 sm:w-28 md:h-36 md:w-36"
            />
          </div>
          <p class="max-w-xs text-xs font-semibold uppercase tracking-[0.16em] text-campaign-warm sm:text-sm md:max-w-sm md:tracking-[0.18em]">
            {hero.eyebrow}
          </p>
        </div>

        <div class="mb-5 rounded-[1.6rem] bg-transparent p-0 md:hidden">
          <PenguinSmartGallery client:media="(max-width: 767px)" />
        </div>

        <div class="inline-flex rounded-full border border-campaign-pink/30 bg-campaign-pink/10 px-4 py-2 text-sm font-medium text-campaign-blush">
          {hero.rotatingLines[0]}
        </div>

        <h1 class="mt-5 max-w-4xl text-[2.8rem] font-black leading-none tracking-tight text-white sm:text-6xl lg:text-8xl">
          <span class="text-gradient">{hero.title}</span>
        </h1>

        <p class="mt-5 max-w-3xl text-base leading-7 text-campaign-text-muted md:text-xl md:leading-8">
          {hero.subtitle}
        </p>

        <div class="mt-6 flex flex-wrap gap-3 md:mt-8 md:gap-4">
          <ButtonLink href="/carta" label={hero.buttons.readLetter} variant="secondary" />
          <ButtonLink href="/firma" label={hero.buttons.signNow} />
        </div>

        <div class="mt-6 md:hidden">
          <Countdown
            targetIso={dates.signatureDeadlineIso}
            expiredMessage="El 25 de abril ya llegó. La movilización sigue."
          />
        </div>
      </div>

      <div class="hidden space-y-6 md:block">
        <Countdown
          targetIso={dates.signatureDeadlineIso}
          expiredMessage="El 25 de abril ya llegó. La movilización sigue."
        />

        <div class="rounded-[2rem] bg-transparent p-4 md:p-5">
          <PenguinSmartGallery client:media="(min-width: 768px)" />
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 mt-10 surface-panel rounded-[2rem] p-6 md:p-8">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-campaign-warm">Deseo</p>
        <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-white md:text-4xl">
          {ecosystem.title}
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-campaign-text-muted md:text-lg">
          {ecosystem.body}
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {ecosystem.pillars.map((pillar) => (
          <article class="rounded-3xl border border-white/12 bg-black/18 p-5">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-campaign-sky/14 text-2xl text-campaign-warm">
              {pillar.icon}
            </div>
            <h3 class="mt-4 text-xl font-semibold text-white">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-6 text-campaign-text-muted">{pillar.description}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="flex flex-wrap items-center gap-3 text-sm font-medium text-campaign-text-muted">
        <span class="rounded-full border border-white/12 bg-white/5 px-4 py-2 text-white">Pingüino</span>
        <span class="text-campaign-sky">→</span>
        <span class="rounded-full border border-white/12 bg-white/5 px-4 py-2 text-white">Océano</span>
        <span class="text-campaign-sky">→</span>
        <span class="rounded-full border border-white/12 bg-white/5 px-4 py-2 text-white">Personas</span>
        <span class="text-campaign-sky">→</span>
        <span class="rounded-full border border-white/12 bg-white/5 px-4 py-2 text-white">Futuro</span>
      </div>

      <div class="rounded-[1.6rem] border border-white/12 bg-black/18 px-5 py-4">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-warm">
          Ventana ciudadana
        </p>
        <p class="mt-3 text-lg font-semibold text-white">Antes del {dates.signatureDeadlineLabel}</p>
        <p class="mt-3 max-w-md text-sm leading-6 text-campaign-text-muted">
          Leer, firmar y compartir son las tres acciones clave de esta fase.
        </p>
      </div>
    </div>
  </div>
</Section>

<script>
  const heroVideo = document.querySelector("[data-hero-video]");
  const playButton = document.querySelector("[data-hero-video-play]");

  if (heroVideo instanceof HTMLVideoElement) {
    const fallbackToMuted = async () => {
      heroVideo.muted = true;
      try {
        await heroVideo.play();
      } catch (error) {
        console.error(error);
      }
    };

    const playWithSoundOnce = async () => {
      heroVideo.pause();
      heroVideo.currentTime = 0;
      heroVideo.muted = false;

      try {
        await heroVideo.play();
      } catch (error) {
        console.error(error);
        await fallbackToMuted();
      }
    };

    heroVideo.addEventListener("ended", () => {
      heroVideo.muted = true;
    });

    if (playButton instanceof HTMLButtonElement) {
      playButton.addEventListener("click", () => {
        playWithSoundOnce();
      });
    }

    playWithSoundOnce();
  }
</script>
