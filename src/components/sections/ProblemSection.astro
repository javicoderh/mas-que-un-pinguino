---
import { campaignConfig } from "../../content/campaign";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import DataCard from "../ui/DataCard.astro";

const { problem } = campaignConfig;
---

<Section id="problema">
  <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
    <SectionHeading eyebrow="Interés" title={problem.title} body={problem.intro} />
    <div class="grid gap-4 md:grid-cols-3">
      {problem.cards.map((card) => <DataCard {...card} />)}
    </div>
  </div>
</Section>
