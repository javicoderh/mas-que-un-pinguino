---
import { createFormToken } from "../../lib/security/form-token";
import { isSecurityConfigured, isServerStorageConfigured } from "../../lib/security/config";
import { campaignConfig } from "../../content/campaign";

const isConfigured = isSecurityConfigured && isServerStorageConfigured;
const formToken = isConfigured ? await createFormToken("foreign_signature_submit") : null;
const letterPdfEs = campaignConfig.assets.publicLetterPdf;
const letterPdfEn = campaignConfig.assets.publicLetterPdfEn;
---

<div class="surface-panel rounded-[2rem] p-7 md:p-8">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-sky">Foreigners / Extranjeros</p>
    <h2 class="mt-3 text-3xl font-black tracking-tight text-white">Sign for the Humboldt Penguin</h2>
    <p class="mt-4 text-base leading-7 text-campaign-text-muted">
      International support matters. Add your voice to protect the Humboldt Penguin and its ecosystem.
    </p>

    <div class="mt-5 grid gap-2 sm:flex sm:flex-wrap sm:items-center">
      <p class="text-sm font-medium text-campaign-text-muted sm:mr-2">Read the letter:</p>
      <a
        href={letterPdfEn}
        target="_blank"
        rel="noopener"
        class="focus-ring inline-flex min-h-9 items-center gap-2 rounded-full border border-campaign-sky/40 bg-campaign-sky/10 px-4 py-2 text-sm font-semibold text-campaign-sky transition hover:bg-campaign-sky/20"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
        </svg>
        Open letter (English)
      </a>
      <a
        href={letterPdfEs}
        target="_blank"
        rel="noopener"
        class="focus-ring inline-flex min-h-9 items-center gap-2 rounded-full border border-white/20 bg-white/8 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/14"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
        </svg>
        Carta abierta (Español)
      </a>
    </div>
  </div>

  <form
    class="grid gap-5"
    method="post"
    action="/api/signatures/foreign"
    data-foreign-signature-form
    data-form-configured={String(isConfigured)}
    novalidate
  >
    <label class="grid gap-2 text-sm font-medium text-white">
      <span>Full name / Nombre completo</span>
      <input
        name="name"
        autocomplete="name"
        required
        data-validate="name"
        class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
        placeholder="Your full name"
      />
      <span class="max-h-0 overflow-hidden text-sm text-red-300 opacity-0 transition-all duration-500" data-error-for="name"></span>
    </label>

    <div class="grid gap-2 text-sm font-medium text-white">
      <span>Country / País</span>
      <div class="relative" data-country-combobox>
        <input
          type="text"
          autocomplete="off"
          spellcheck="false"
          data-country-search
          placeholder="Type to search your country..."
          class="focus-ring min-h-12 w-full rounded-2xl border border-white/14 bg-white/6 px-4 py-3 pr-10 text-white placeholder:text-campaign-text-muted"
        />
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-campaign-text-muted"
          viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
        >
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        <input type="hidden" name="country" data-validate="country" />
        <ul
          role="listbox"
          aria-label="Countries"
          data-country-dropdown
          class="absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-56 overflow-y-auto rounded-2xl border border-white/14 bg-[#0f1822] py-1 shadow-xl"
        ></ul>
      </div>
      <span class="max-h-0 overflow-hidden text-sm text-red-300 opacity-0 transition-all duration-500" data-error-for="country"></span>
    </div>

    <label class="grid gap-2 text-sm font-medium text-white">
      <span>Email</span>
      <input
        type="email"
        name="email"
        autocomplete="email"
        required
        data-validate="email"
        class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
        placeholder="your@email.com"
      />
      <span class="max-h-0 overflow-hidden text-sm text-red-300 opacity-0 transition-all duration-500" data-error-for="email"></span>
    </label>

    <label class="grid gap-2 text-sm font-medium text-white">
      <span>Why do you support this cause? / ¿Por qué apoyas esta causa?</span>
      <textarea
        name="reason"
        rows="4"
        required
        data-validate="reason"
        class="focus-ring rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
        placeholder="Tell us why this matters to you..."
      ></textarea>
      <span class="max-h-0 overflow-hidden text-sm text-red-300 opacity-0 transition-all duration-500" data-error-for="reason"></span>
    </label>

    <div class="grid gap-3">
      <label class="flex items-start gap-3 rounded-2xl border border-white/12 bg-white/5 p-4 text-sm text-campaign-text-muted">
        <input
          type="checkbox"
          name="consent"
          required
          data-validate="consent"
          class="mt-1 h-4 w-4 rounded border-white/20 bg-black text-campaign-warm"
        />
        <span>
          I authorize the use of my data to support this campaign and have read the{" "}
          <a href="/privacidad" class="font-semibold text-campaign-warm underline underline-offset-4 hover:text-[#FFF1A8]">
            privacy policy
          </a>
          .
        </span>
      </label>
      <span class="max-h-0 overflow-hidden text-sm text-red-300 opacity-0 transition-all duration-500" data-error-for="consent"></span>
    </div>

    <input type="hidden" name="issued_at_ms" value={formToken?.issuedAtMs ?? ""} />
    <input type="hidden" name="form_nonce" value={formToken?.nonce ?? ""} />
    <input type="hidden" name="form_token" value={formToken?.signature ?? ""} />

    <div class="grid gap-4 border-t border-white/10 pt-5">
      {!isConfigured && (
        <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/8 px-4 py-3 text-sm text-campaign-sky">
          Server-side configuration is missing. Signature registration is not active.
        </p>
      )}
      <button
        type="submit"
        data-foreign-submit
        class="focus-ring button-text-outline inline-flex min-h-12 items-center justify-center rounded-full border border-black/55 bg-campaign-sky px-6 py-3 text-[0.95rem] font-extrabold uppercase tracking-[0.08em] text-white shadow-[0_18px_60px_rgba(56,182,255,0.3),inset_0_1px_0_rgba(255,255,255,0.24)] transition hover:bg-[#63C6FF]"
      >
        Sign / Firmar
      </button>
      <p class="text-sm text-campaign-text-muted" data-foreign-status>
        Your data will be validated and protected before registering your signature.
      </p>
    </div>
  </form>
</div>

<script>
const COUNTRIES = [
  "Afghanistan","Albania","Algeria","Andorra","Angola","Antigua and Barbuda","Argentina",
  "Armenia","Australia","Austria","Azerbaijan","Bahamas","Bahrain","Bangladesh","Barbados",
  "Belarus","Belgium","Belize","Benin","Bhutan","Bolivia","Bosnia and Herzegovina","Botswana",
  "Brazil","Brunei","Bulgaria","Burkina Faso","Burundi","Cabo Verde","Cambodia","Cameroon",
  "Canada","Central African Republic","Chad","Chile","Colombia","Comoros","Congo",
  "Costa Rica","Croatia","Cuba","Cyprus","Czech Republic","Democratic Republic of the Congo",
  "Denmark","Djibouti","Dominica","Dominican Republic","Ecuador","Egypt","El Salvador",
  "Equatorial Guinea","Eritrea","Estonia","Eswatini","Ethiopia","Fiji","Finland","France",
  "Gabon","Gambia","Georgia","Germany","Ghana","Greece","Grenada","Guatemala","Guinea",
  "Guinea-Bissau","Guyana","Haiti","Honduras","Hungary","Iceland","India","Indonesia",
  "Iran","Iraq","Ireland","Israel","Italy","Jamaica","Japan","Jordan","Kazakhstan","Kenya",
  "Kiribati","Kuwait","Kyrgyzstan","Laos","Latvia","Lebanon","Lesotho","Liberia","Libya",
  "Liechtenstein","Lithuania","Luxembourg","Madagascar","Malawi","Malaysia","Maldives",
  "Mali","Malta","Marshall Islands","Mauritania","Mauritius","Mexico","Micronesia",
  "Moldova","Monaco","Mongolia","Montenegro","Morocco","Mozambique","Myanmar","Namibia",
  "Nauru","Nepal","Netherlands","New Zealand","Nicaragua","Niger","Nigeria","North Korea",
  "North Macedonia","Norway","Oman","Pakistan","Palau","Palestine","Panama",
  "Papua New Guinea","Paraguay","Peru","Philippines","Poland","Portugal","Qatar",
  "Romania","Russia","Rwanda","Saint Kitts and Nevis","Saint Lucia",
  "Saint Vincent and the Grenadines","Samoa","San Marino","Sao Tome and Principe",
  "Saudi Arabia","Senegal","Serbia","Seychelles","Sierra Leone","Singapore","Slovakia",
  "Slovenia","Solomon Islands","Somalia","South Africa","South Korea","South Sudan",
  "Spain","Sri Lanka","Sudan","Suriname","Sweden","Switzerland","Syria","Taiwan",
  "Tajikistan","Tanzania","Thailand","Timor-Leste","Togo","Tonga","Trinidad and Tobago",
  "Tunisia","Turkey","Turkmenistan","Tuvalu","Uganda","Ukraine","United Arab Emirates",
  "United Kingdom","United States","Uruguay","Uzbekistan","Vanuatu","Vatican City",
  "Venezuela","Vietnam","Yemen","Zambia","Zimbabwe"
];

const form = document.querySelector("[data-foreign-signature-form]");
const status = document.querySelector("[data-foreign-status]");
const submitButton = document.querySelector("[data-foreign-submit]");
const errorTimers = new Map<string, number>();

if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
  const formEl = form; // capture narrowed type for use inside nested functions

  // ── Country combobox ────────────────────────────────────────────────────────
  const searchInput  = form.querySelector("[data-country-search]") as HTMLInputElement | null;
  const hiddenInput  = form.querySelector("[name='country']") as HTMLInputElement | null;
  const dropdown     = form.querySelector("[data-country-dropdown]") as HTMLElement | null;
  const searchWrap   = form.querySelector("[data-country-combobox]") as HTMLElement | null;

  let activeIndex = -1;

  function filterCountries(q: string) {
    const lower = q.toLowerCase().trim();
    if (!lower) return COUNTRIES;
    return COUNTRIES.filter((c) => c.toLowerCase().includes(lower));
  }

  function renderDropdown(items: string[]) {
    if (!dropdown) return;
    dropdown.innerHTML = "";
    activeIndex = -1;
    if (items.length === 0) {
      const li = document.createElement("li");
      li.className = "px-4 py-3 text-sm text-campaign-text-muted select-none";
      li.textContent = "No results found.";
      dropdown.appendChild(li);
    } else {
      items.forEach((country, i) => {
        const li = document.createElement("li");
        li.role = "option";
        li.dataset.index = String(i);
        li.className =
          "cursor-pointer px-4 py-3 text-sm text-white transition-colors hover:bg-white/10";
        li.textContent = country;
        li.addEventListener("mousedown", (e) => {
          e.preventDefault(); // prevent blur before click
          selectCountry(country);
        });
        dropdown.appendChild(li);
      });
    }
  }

  function openDropdown() {
    if (!dropdown || !searchInput) return;
    const items = filterCountries(searchInput.value);
    renderDropdown(items);
    dropdown.classList.remove("hidden");
  }

  function closeDropdown() {
    dropdown?.classList.add("hidden");
    activeIndex = -1;
  }

  function setActiveItem(index: number) {
    if (!dropdown) return;
    const items = dropdown.querySelectorAll("li[data-index]");
    items.forEach((li, i) => {
      li.classList.toggle("bg-white/10", i === index);
    });
    activeIndex = index;
    if (index >= 0 && items[index] instanceof HTMLElement) {
      (items[index] as HTMLElement).scrollIntoView({ block: "nearest" });
    }
  }

  function selectCountry(country: string) {
    if (!hiddenInput || !searchInput) return;
    hiddenInput.value = country;
    searchInput.value = country;
    closeDropdown();
    // update border state to match valid
    searchInput.classList.remove("border-red-400", "bg-red-950/20");
    searchInput.classList.add("border-white/14");
    clearError("country");
  }

  searchInput?.addEventListener("focus", () => openDropdown());

  searchInput?.addEventListener("input", () => {
    if (!hiddenInput) return;
    hiddenInput.value = ""; // clear hidden value while user is typing
    const items = filterCountries(searchInput.value);
    renderDropdown(items);
    dropdown?.classList.remove("hidden");
  });

  searchInput?.addEventListener("blur", () => {
    // Small delay so mousedown on a list item fires first
    setTimeout(() => {
      closeDropdown();
      // If search text doesn't match the confirmed selection, clear hidden value
      if (hiddenInput && searchInput.value !== hiddenInput.value) {
        hiddenInput.value = "";
        if (searchInput.value.trim()) {
          validateField("country");
        }
      }
    }, 150);
  });

  searchInput?.addEventListener("keydown", (e: KeyboardEvent) => {
    if (!dropdown || dropdown.classList.contains("hidden")) {
      if (e.key === "ArrowDown" || e.key === "Enter") openDropdown();
      return;
    }
    const items = dropdown.querySelectorAll("li[data-index]");
    const count = items.length;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActiveItem(Math.min(activeIndex + 1, count - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActiveItem(Math.max(activeIndex - 1, 0));
    } else if (e.key === "Enter") {
      e.preventDefault();
      if (activeIndex >= 0 && items[activeIndex]) {
        selectCountry((items[activeIndex] as HTMLElement).textContent ?? "");
      }
    } else if (e.key === "Escape") {
      closeDropdown();
    }
  });

  // Close if clicking outside
  document.addEventListener("click", (e) => {
    if (searchWrap && !searchWrap.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // ── Validation ──────────────────────────────────────────────────────────────
  interface ValidationRule {
    required: boolean;
    message: string;
    regex?: RegExp;
  }

  const validators: Record<string, ValidationRule> = {
    name: {
      required: true,
      regex: /^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ'\-\s]{2,120}$/,
      message: "Please enter a valid name (letters only, 2–120 characters)."
    },
    country: {
      required: true,
      message: "Please select a country from the list."
    },
    email: {
      required: true,
      regex: /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/,
      message: "Please enter a valid email address."
    },
    reason: {
      required: true,
      regex: /^[\s\S]{5,600}$/,
      message: "Please tell us why you support this cause (5–600 characters)."
    },
    consent: {
      required: true,
      message: "You must accept the consent to sign."
    }
  };

  type FieldName = keyof typeof validators & string;

  const getField = (name: string) => form.elements.namedItem(name);

  const getValue = (name: string) => {
    const field = form.elements.namedItem(name);
    return field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement
      ? field.value.trim()
      : "";
  };

  function showError(name: string, message: string) {
    const node = formEl.querySelector(`[data-error-for="${name}"]`);
    // For country, mark the search input (visible), not the hidden input
    const fieldEl = name === "country" ? searchInput : getField(name);
    if (fieldEl instanceof HTMLInputElement || fieldEl instanceof HTMLTextAreaElement) {
      fieldEl.classList.add("border-red-400", "bg-red-950/20");
      fieldEl.classList.remove("border-white/14");
    }
    if (node instanceof HTMLElement) {
      node.textContent = message;
      node.classList.remove("opacity-0", "max-h-0");
      node.classList.add("opacity-100", "max-h-16", "mt-1");
      const prev = errorTimers.get(name);
      if (prev) window.clearTimeout(prev);
      errorTimers.set(name, window.setTimeout(() => {
        node.classList.add("opacity-0", "max-h-0");
        node.classList.remove("opacity-100", "max-h-16", "mt-1");
      }, 5000));
    }
  }

  function clearError(name: string) {
    const node = formEl.querySelector(`[data-error-for="${name}"]`);
    const fieldEl = name === "country" ? searchInput : getField(name);
    if (fieldEl instanceof HTMLInputElement || fieldEl instanceof HTMLTextAreaElement) {
      fieldEl.classList.remove("border-red-400", "bg-red-950/20");
      fieldEl.classList.add("border-white/14");
    }
    if (node instanceof HTMLElement) {
      node.classList.add("opacity-0", "max-h-0");
      node.classList.remove("opacity-100", "max-h-16", "mt-1");
    }
    const prev = errorTimers.get(name);
    if (prev) window.clearTimeout(prev);
  }

  function validateField(name: FieldName): boolean {
    const rule = validators[name];
    if (!rule) return true;

    if (name === "consent") {
      const field = getField(name);
      const checked = field instanceof HTMLInputElement ? field.checked : false;
      if (!checked) { showError(name, rule.message); return false; }
      clearError(name);
      return true;
    }

    if (name === "country") {
      const value = getValue("country");
      if (!value) {
        showError("country", rule.message);
        return false;
      }
      clearError("country");
      return true;
    }

    const value = getValue(name);
    if (rule.required && !value) { showError(name, "This field is required."); return false; }
    if (!value) { clearError(name); return true; }
    if (rule.regex && !rule.regex.test(value)) { showError(name, rule.message); return false; }
    clearError(name);
    return true;
  }

  // ── Submit ──────────────────────────────────────────────────────────────────
  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (form.dataset.formConfigured !== "true") {
      status.textContent = "The form is not configured yet. Please try again later.";
      return;
    }

    const fields = Object.keys(validators) as FieldName[];
    const results = fields.map((n) => ({ n, valid: validateField(n) }));
    const firstInvalid = results.find((r) => !r.valid);
    if (firstInvalid) {
      status.textContent = "Please fix the highlighted fields.";
      const target = firstInvalid.n === "country" ? searchInput : getField(firstInvalid.n);
      if (target instanceof HTMLElement) {
        target.focus({ preventScroll: true });
        target.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      return;
    }

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
    }
    status.textContent = "Registering your signature...";

    try {
      const response = await fetch("/api/signatures/foreign", {
        method: "POST",
        body: new FormData(form),
        headers: { accept: "application/json" }
      });
      const payload = await response.json();

      if (!response.ok) {
        status.textContent = typeof payload.message === "string"
          ? payload.message
          : "Could not process your signature. Please try again.";
        return;
      }

      form.reset();
      if (hiddenInput) hiddenInput.value = "";
      if (searchInput) searchInput.value = "";
      status.textContent = typeof payload.message === "string"
        ? payload.message
        : "Thank you! Your signature has been registered.";
    } catch {
      status.textContent = "Network error. Please try again.";
    } finally {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.textContent = "Sign / Firmar";
      }
    }
  });

  // ── Real-time listeners for non-combobox fields ──────────────────────────────
  (["name", "email", "reason"] as FieldName[]).forEach((name) => {
    const field = getField(name);
    if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
      field.addEventListener("input", () => validateField(name));
      field.addEventListener("blur", () => validateField(name));
    }
  });

  const consentField = getField("consent");
  if (consentField instanceof HTMLInputElement) {
    consentField.addEventListener("change", () => validateField("consent"));
  }
}
</script>
