---
import { campaignConfig } from "../../content/campaign";

interface Props {
  initialCount?: number;
  initialChileanCount?: number;
  initialForeignCount?: number;
}

const { hero } = campaignConfig;
const formatCount = (value: number) => new Intl.NumberFormat("es-CL").format(value);

const {
  initialCount = 0,
  initialChileanCount = 0,
  initialForeignCount = 0
} = Astro.props;
---

<aside class="fixed bottom-6 right-4 z-50 hidden w-[calc(100vw-2rem)] max-w-xs md:block" aria-label="Contador de firmas">
  <div class="flex w-full items-start gap-3 rounded-[1.6rem] border border-white/14 bg-[#070b15] px-5 py-4 text-left shadow-[0_24px_70px_rgba(0,0,0,0.42)]">
    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/6 text-campaign-sky">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm1 5v4.59l3.3 3.3-1.42 1.41L11 12.41V7Z"></path>
      </svg>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-campaign-sky">
        {hero.signaturesCounter.label}
      </p>
      <p class="mt-2 text-3xl font-black leading-none text-white" data-signature-counter-value>
        {formatCount(initialCount)}
      </p>
      <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
        <div class="rounded-2xl border border-white/10 bg-white/6 px-2.5 py-2 text-center">
          <p class="text-[10px] font-semibold uppercase tracking-[0.1em] text-campaign-sky/90">Chilenas</p>
          <p class="mt-1 text-lg font-black leading-none text-white" data-signature-counter-chile>{formatCount(initialChileanCount)}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/6 px-2.5 py-2 text-center">
          <p class="text-[10px] font-semibold uppercase tracking-[0.1em] text-campaign-sky/90">Extranjeras</p>
          <p class="mt-1 text-lg font-black leading-none text-white" data-signature-counter-foreign>{formatCount(initialForeignCount)}</p>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  import { getSignatureCount, invalidateSignatureCountCache } from "../../lib/signatures";

  const valueNode = document.querySelector("[data-signature-counter-value]");
  const chileNode = document.querySelector("[data-signature-counter-chile]");
  const foreignNode = document.querySelector("[data-signature-counter-foreign]");
  const fmt = (n: number) => new Intl.NumberFormat("es-CL").format(n);

  const refresh = async () => {
    if (!(valueNode instanceof HTMLElement)) return;
    try {
      const c = await getSignatureCount();
      valueNode.textContent = fmt(c.count);
      if (chileNode instanceof HTMLElement) chileNode.textContent = fmt(c.chileanCount);
      if (foreignNode instanceof HTMLElement) foreignNode.textContent = fmt(c.foreignCount);
    } catch { /* keep displayed value */ }
  };

  refresh();
  window.addEventListener("signature:created", () => { invalidateSignatureCountCache(); refresh(); });
  window.setInterval(() => { invalidateSignatureCountCache(); refresh(); }, 1000 * 60 * 10);
</script>
