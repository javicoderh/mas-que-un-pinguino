---
import { campaignConfig } from "../../content/campaign";
import { getCachedPublicSignatureBreakdown } from "../../lib/security/storage";

const { hero } = campaignConfig;
const formatCount = (value: number) => new Intl.NumberFormat("es-CL").format(value);

let initialCount = Number(hero.signaturesCounter.value ?? 0);
let initialChileanCount = 0;
let initialForeignCount = 0;

try {
  const breakdown = await getCachedPublicSignatureBreakdown();
  initialCount = breakdown.count;
  initialChileanCount = breakdown.chileanCount;
  initialForeignCount = breakdown.foreignCount;
} catch (error) {
  console.error("signature-counter-ssr-fallback", error);
}
---

<aside
  class="fixed right-2 top-[11.25rem] z-50 w-[12.75rem] max-w-[calc(100vw-1rem)] origin-top-right scale-[0.95] md:bottom-6 md:right-4 md:top-auto md:w-[calc(100vw-2rem)] md:max-w-xs md:scale-100"
  aria-label="Contador de firmas"
>
  <div
    class="surface-panel flex w-full items-start gap-2.5 rounded-[1.4rem] border border-white/14 px-3 py-3 text-left shadow-[0_24px_70px_rgba(0,0,0,0.42)] md:gap-3 md:rounded-[1.6rem] md:px-5 md:py-4"
  >
    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/6 text-campaign-sky md:h-9 md:w-9">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-current md:h-4 md:w-4">
        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm1 5v4.59l3.3 3.3-1.42 1.41L11 12.41V7Z"></path>
      </svg>
    </div>

    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-campaign-sky">
        {hero.signaturesCounter.label}
      </p>
      <p class="mt-1.5 text-2xl font-black leading-none text-white md:mt-2 md:text-3xl" data-signature-counter-value>
        {formatCount(initialCount)}
      </p>
      <div class="mt-2 grid grid-cols-2 gap-2 text-[10px] md:mt-3 md:text-xs">
        <div class="rounded-2xl border border-white/10 bg-white/6 px-2 py-2 text-center md:px-2.5">
          <p class="text-[8px] font-semibold uppercase leading-tight tracking-[0.06em] text-campaign-sky/90 md:text-[10px] md:tracking-[0.1em]">Chilenas</p>
          <p class="mt-1 text-sm font-black leading-none text-white md:text-lg" data-signature-counter-chile>{formatCount(initialChileanCount)}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/6 px-2 py-2 text-center md:px-2.5">
          <p class="text-[8px] font-semibold uppercase leading-tight tracking-[0.06em] text-campaign-sky/90 md:text-[10px] md:tracking-[0.1em]">Extranjeras</p>
          <p class="mt-1 text-sm font-black leading-none text-white md:text-lg" data-signature-counter-foreign>{formatCount(initialForeignCount)}</p>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  import { getSignatureCount } from "../../lib/signatures";

  const valueNode = document.querySelector("[data-signature-counter-value]");
  const chileNode = document.querySelector("[data-signature-counter-chile]");
  const foreignNode = document.querySelector("[data-signature-counter-foreign]");
  const formatCount = (value: number) => new Intl.NumberFormat("es-CL").format(value);

  const refreshCounter = async () => {
    if (!(valueNode instanceof HTMLElement)) return;

    try {
      const counts = await getSignatureCount();
      valueNode.textContent = formatCount(counts.count);
      if (chileNode instanceof HTMLElement) {
        chileNode.textContent = formatCount(counts.chileanCount);
      }
      if (foreignNode instanceof HTMLElement) {
        foreignNode.textContent = formatCount(counts.foreignCount);
      }
    } catch (error) {
      console.error(error);
      if (chileNode instanceof HTMLElement) {
        chileNode.textContent = "0";
      }
      if (foreignNode instanceof HTMLElement) {
        foreignNode.textContent = "0";
      }
    }
  };

  refreshCounter();
  window.addEventListener("signature:created", refreshCounter);
  window.setInterval(refreshCounter, 1000 * 60 * 10);
</script>
