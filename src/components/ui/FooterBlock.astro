---
import { campaignConfig } from "../../content/campaign";
import logo from "../../assets/logo_pinguino_humboldt_circulo.png";
import ButtonLink from "./ButtonLink.astro";

const { transparency, socialLinks, links, site } = campaignConfig;
---

<footer class="border-t border-white/10 bg-black/40">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
    <div class="space-y-6">
      <div class="flex items-center gap-5">
        <img
          src={logo.src}
          alt={`Logo de ${site.name}`}
          class="h-20 w-20 rounded-full border border-white/16 bg-white/6 object-contain p-2 shadow-[0_16px_40px_rgba(0,0,0,0.28)]"
        />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-pink">Es más que un pingüino</p>
          <p class="text-xl font-black text-white">Campaña ciudadana por el Monumento Natural</p>
        </div>
      </div>

      <p class="max-w-2xl text-sm leading-7 text-campaign-text-muted">{transparency.body}</p>

      <ul class="flex flex-wrap gap-2">
        {transparency.principles.map((principle) => (
          <li class="rounded-full border border-white/12 bg-white/5 px-4 py-2 text-xs font-medium text-white">
            {principle}
          </li>
        ))}
      </ul>
    </div>

    <div class="space-y-6">
      <div class="surface-panel rounded-3xl p-6">
        <h2 class="text-xl font-semibold text-white">Carta y transparencia</h2>
        <p class="mt-3 text-sm leading-6 text-campaign-text-muted">
          Revisa la carta abierta, consulta el bloque de transparencia y comparte la base científica de la campaña.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <ButtonLink href={links.letterPdf} label="Abrir PDF" target="_blank" />
          <ButtonLink href="/transparencia" label="Ver transparencia" variant="secondary" />
        </div>
      </div>

      <div class="flex flex-wrap gap-4 text-sm text-campaign-text-muted">
        <a href="/carta" class="focus-ring hover:text-white">Carta</a>
        <a href="/firma" class="focus-ring hover:text-white">Firma</a>
        <a href="/transparencia" class="focus-ring hover:text-white">Transparencia</a>
        {socialLinks.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer noopener" class="focus-ring hover:text-white">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
