---
interface Props {
  value: string;
  label: string;
  detail: string;
}

const { value, label, detail } = Astro.props;
---

<article class="surface-panel rounded-3xl p-6">
  <p class="whitespace-nowrap text-4xl font-bold text-campaign-warm md:text-5xl">{value}</p>
  <h3 class="mt-4 text-xl font-semibold text-white">{label}</h3>
  <p class="mt-3 text-sm leading-6 text-campaign-text-muted">{detail}</p>
</article>
