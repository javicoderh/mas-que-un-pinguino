---
import splashVideo from "../../assets/splash-2.mp4";
---

<div id="splash-screen" class="splash-screen" aria-hidden="true">
  <div class="splash-stage">
    <div class="splash-video-frame">
      <video
        id="splash-video"
        class="splash-video"
        src={splashVideo}
        autoplay
        muted
        playsinline
        preload="auto"
      ></video>

      <span id="splash-signature-mask" class="splash-signature-mask" aria-hidden="true"></span>

      <div id="splash-hashtag" class="splash-hashtag">
        <span class="splash-hashtag-line">
          <span id="splash-hashtag-text"></span><span id="splash-cursor" class="splash-cursor">|</span>
        </span>
      </div>
    </div>
  </div>

  <div id="splash-pixels" class="splash-pixels" aria-hidden="true"></div>
</div>

<style>
  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #000;
    overflow: hidden;
    isolation: isolate;
    transition: background-color 0.5s ease;
  }

  .splash-screen.is-disintegrating {
    background: transparent;
  }

  .splash-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.4s ease;
  }

  .splash-stage.is-gone {
    opacity: 0;
  }

  /* Marco con el aspect ratio del video (1920×1080) para anclar el hashtag
     directamente sobre el lienzo y que el posicionamiento sea estable en
     cualquier tamaño de pantalla. */
  .splash-video-frame {
    position: relative;
    width: min(86vw, 760px);
    aspect-ratio: 16 / 9;
    max-height: 80vh;
  }

  .splash-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
  }

  /* Tapa la firma "Veo" del artista. Empieza negro (matching el lienzo negro
     del comienzo del video) y a t≈0.35s transiciona a una gradiente radial
     de beiges con borde transparente — así blendea de forma natural con la
     textura del lienzo en lugar de quedar como un parche plano. */
  .splash-signature-mask {
    position: absolute;
    right: 1%;
    bottom: 2%;
    width: 9%;
    height: 6%;
    background: #000;
    z-index: 2;
    pointer-events: none;
    transition: background 0.6s ease, opacity 0.6s ease;
  }

  .splash-signature-mask.is-beige {
    background: radial-gradient(
      ellipse at center,
      #6E5641 0%,
      #7B6249 30%,
      #876E54 55%,
      rgba(135, 110, 84, 0.78) 78%,
      rgba(135, 110, 84, 0.35) 92%,
      transparent 100%
    );
  }

  /* El hashtag se ubica sobre el lienzo del video, dentro del marco. */
  .splash-hashtag {
    position: absolute;
    left: 50%;
    bottom: 7%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .splash-hashtag.is-visible {
    opacity: 1;
  }

  .splash-hashtag-line {
    color: #fff;
    font-family: "Caveat", cursive;
    font-size: clamp(1.6rem, 4.6vw, 3.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    display: inline-block;
    transform: rotate(-2deg);
    white-space: nowrap;
    -webkit-text-stroke: 1.5px #00b3ff;
    text-shadow:
      0 0 4px #00b3ff,
      0 0 10px #00b3ff,
      0 0 22px rgba(0, 179, 255, 0.85),
      0 0 40px rgba(0, 179, 255, 0.55);
  }

  .splash-cursor {
    display: inline-block;
    margin-left: 0.06em;
    animation: splash-blink 0.65s steps(1) infinite;
  }

  .splash-cursor.is-done {
    display: none;
  }

  @keyframes splash-blink {
    50% { opacity: 0; }
  }

  .splash-pixels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .splash-pixel {
    position: absolute;
    background: #000;
    will-change: transform, opacity;
  }

  .splash-pixel.is-scattering {
    animation: splash-pixel-scatter 1.1s cubic-bezier(0.55, 0.05, 0.45, 0.95) forwards;
  }

  @keyframes splash-pixel-scatter {
    0% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 1;
    }
    60% {
      opacity: 0.85;
    }
    100% {
      transform: translate(var(--dx), var(--dy)) scale(0.25) rotate(var(--rot));
      opacity: 0;
    }
  }

  .splash-screen.is-done {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-cursor {
      animation: none;
    }
    .splash-pixel.is-scattering {
      animation-duration: 0.4s;
    }
  }
</style>

<script>
  const HASHTAG = "#esmásqueunpingüino";
  const TYPE_INTERVAL_MS = 90;
  const PIXEL_SIZE = 26;
  const POST_TYPE_HOLD_MS = 2200;
  const SCATTER_DURATION_MS = 1100;

  const splash = document.getElementById("splash-screen");

  if (splash) {
    if (sessionStorage.getItem("splash:seen") === "1") {
      splash.remove();
    } else {
      const video = document.getElementById("splash-video") as HTMLVideoElement | null;
      const stage = splash.querySelector<HTMLElement>(".splash-stage");
      const hashtagWrap = document.getElementById("splash-hashtag");
      const hashtagText = document.getElementById("splash-hashtag-text");
      const cursor = document.getElementById("splash-cursor");
      const pixelsContainer = document.getElementById("splash-pixels");
      const signatureMask = document.getElementById("splash-signature-mask");

      // El beige cubre la esquina del "Veo" alrededor de t=0.85s del video.
      // Disparamos el cambio 0.5s antes (t=0.35s) para que la gradiente
      // alcance a fundirse con la textura cuando el lienzo termine de pintarse.
      const SIG_BEIGE_AT_S = 0.35;
      let sigSwapped = false;
      const onTimeUpdate = () => {
        if (sigSwapped || !video || !signatureMask) return;
        if (video.currentTime >= SIG_BEIGE_AT_S) {
          signatureMask.classList.add("is-beige");
          sigSwapped = true;
          video.removeEventListener("timeupdate", onTimeUpdate);
        }
      };
      video?.addEventListener("timeupdate", onTimeUpdate);

      document.documentElement.style.overflow = "hidden";

      let finished = false;

      const disintegrate = () => {
        if (finished || !pixelsContainer) return;
        finished = true;

        const W = window.innerWidth;
        const H = window.innerHeight;
        const cols = Math.ceil(W / PIXEL_SIZE) + 1;
        const rows = Math.ceil(H / PIXEL_SIZE) + 1;
        const cx = W / 2;
        const cy = H / 2;
        const maxDist = Math.hypot(cx, cy);

        const frag = document.createDocumentFragment();
        const pixels: HTMLSpanElement[] = [];
        for (let r = 0; r < rows; r += 1) {
          for (let c = 0; c < cols; c += 1) {
            const px = document.createElement("span");
            px.className = "splash-pixel";
            const x = c * PIXEL_SIZE;
            const y = r * PIXEL_SIZE;
            px.style.left = `${x}px`;
            px.style.top = `${y}px`;
            px.style.width = `${PIXEL_SIZE}px`;
            px.style.height = `${PIXEL_SIZE}px`;
            const angle = Math.atan2(y + PIXEL_SIZE / 2 - cy, x + PIXEL_SIZE / 2 - cx);
            const distNorm = Math.hypot(x - cx, y - cy) / maxDist;
            const reach = 220 + Math.random() * 260;
            const dx = Math.cos(angle) * reach + (Math.random() - 0.5) * 80;
            const dy = Math.sin(angle) * reach + (Math.random() - 0.5) * 80;
            const rot = (Math.random() - 0.5) * 540;
            px.style.setProperty("--dx", `${dx.toFixed(1)}px`);
            px.style.setProperty("--dy", `${dy.toFixed(1)}px`);
            px.style.setProperty("--rot", `${rot.toFixed(1)}deg`);
            const delay = distNorm * 320 + Math.random() * 140;
            px.style.animationDelay = `${delay.toFixed(0)}ms`;
            frag.appendChild(px);
            pixels.push(px);
          }
        }
        pixelsContainer.appendChild(frag);

        // Tras inyectar los píxeles encima del stage, hacemos transparente el
        // fondo del splash: ahora solo los píxeles tapan el homepage.
        // Luego escondemos el stage (video + hashtag) y los píxeles se dispersan.
        requestAnimationFrame(() => {
          splash.classList.add("is-disintegrating");
          stage?.classList.add("is-gone");
          for (const px of pixels) px.classList.add("is-scattering");
        });

        window.setTimeout(() => {
          splash.classList.add("is-done");
          sessionStorage.setItem("splash:seen", "1");
          document.documentElement.style.overflow = "";
          splash.remove();
        }, SCATTER_DURATION_MS + 500);
      };

      const typeHashtag = () => {
        if (!hashtagWrap || !hashtagText || !cursor) {
          disintegrate();
          return;
        }
        hashtagWrap.classList.add("is-visible");
        let i = 0;
        const tick = () => {
          if (i <= HASHTAG.length) {
            hashtagText.textContent = HASHTAG.slice(0, i);
            i += 1;
            window.setTimeout(tick, TYPE_INTERVAL_MS);
          } else {
            cursor.classList.add("is-done");
            window.setTimeout(disintegrate, POST_TYPE_HOLD_MS);
          }
        };
        window.setTimeout(tick, 200);
      };

      const startHashtag = () => {
        // Congelamos el video en su último frame: si está disponible saltamos
        // al final exacto, así no se queda en negro entre que termina y entra
        // el hashtag (el navegador a veces se demora en pintar el frame final).
        if (video && !Number.isNaN(video.duration) && video.duration > 0) {
          try {
            video.pause();
            video.currentTime = Math.max(0, video.duration - 0.05);
          } catch {
            /* noop */
          }
        }
        // Pequeña pausa para que el último frame se asiente y luego empezamos
        // a escribir el hashtag encima del pingüino.
        window.setTimeout(typeHashtag, 220);
      };

      if (video) {
        video.addEventListener("ended", startHashtag, { once: true });
        video.addEventListener("error", startHashtag, { once: true });
        // Safety net: si "ended" no se dispara, avanzamos después de 12s
        window.setTimeout(() => {
          if (!finished && hashtagWrap && !hashtagWrap.classList.contains("is-visible")) {
            startHashtag();
          }
        }, 12000);
      } else {
        typeHashtag();
      }
    }
  }
</script>
