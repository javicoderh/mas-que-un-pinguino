---
interface SocialLink {
  href: string;
  label: string;
}

interface Props {
  links: readonly SocialLink[];
}

const { links } = Astro.props;
const publicLinks = links.filter((link) => /^https?:\/\//.test(link.href));
---

<div class="flex flex-wrap gap-3">
  {publicLinks.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noreferrer noopener"
      data-analytics-event="social_click"
      data-analytics-label={link.label}
      data-analytics-context="social_links_row"
      class="focus-ring inline-flex min-h-12 items-center rounded-full border border-white/15 bg-white/6 px-5 py-3 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-campaign-sky hover:bg-white/10"
    >
      {link.label}
    </a>
  ))}
</div>
