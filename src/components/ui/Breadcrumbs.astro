---
export interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <nav aria-label="Breadcrumb" class="mb-6">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-campaign-text-muted">
      {items.map((item, index) => {
        const isCurrent = index === items.length - 1;
        return (
          <>
            <li>
              {isCurrent ? (
                <span aria-current="page" class="font-medium text-white">
                  {item.name}
                </span>
              ) : (
                <a href={item.path} class="focus-ring transition hover:text-campaign-warm">
                  {item.name}
                </a>
              )}
            </li>
            {!isCurrent && <li aria-hidden="true">/</li>}
          </>
        );
      })}
    </ol>
  </nav>
)}
