---
interface Props {
  name: string;
  uploadEndpoint: string;
  currentUrl?: string;
  required?: boolean;
  label?: string;
}

const {
  name,
  uploadEndpoint,
  currentUrl = "",
  required = false,
  label = "Imagen"
} = Astro.props;

const fieldId = `img-upload-${name}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="image-upload-field grid gap-2" data-upload-field data-endpoint={uploadEndpoint}>
  <span class="text-sm font-medium text-white">
    {label}{!required && <span class="ml-1 font-normal text-campaign-text-muted">(opcional)</span>}
  </span>

  <input type="hidden" name={name} value={currentUrl} data-upload-url />

  {currentUrl && (
    <div class="relative overflow-hidden rounded-2xl bg-black/30" data-upload-preview-wrap>
      <img
        src={currentUrl}
        alt="Vista previa"
        class="h-40 w-full object-contain"
        data-upload-preview
      />
    </div>
  )}
  {!currentUrl && (
    <div class="hidden relative overflow-hidden rounded-2xl bg-black/30" data-upload-preview-wrap>
      <img
        src=""
        alt="Vista previa"
        class="h-40 w-full object-contain"
        data-upload-preview
      />
    </div>
  )}

  <label
    id={fieldId}
    class="flex cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-white/20 bg-white/4 px-4 py-6 text-center transition hover:border-campaign-sky/50 hover:bg-white/6"
    data-upload-label
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8 text-campaign-sky fill-none stroke-current stroke-2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
    </svg>
    <span class="text-sm font-medium text-white" data-upload-label-text>
      {currentUrl ? "Cambiar imagen" : "Seleccionar imagen"}
    </span>
    <span class="text-xs text-campaign-text-muted">JPG, PNG, WebP o GIF · máx. 8 MB</span>
    <input
      type="file"
      accept="image/jpeg,image/png,image/webp,image/gif"
      class="sr-only"
      data-upload-input
    />
  </label>

  <p class="hidden text-sm text-red-300" data-upload-error></p>
</div>

<script>
  document.querySelectorAll("[data-upload-field]").forEach((field) => {
    const endpoint = field.getAttribute("data-endpoint") ?? "";
    const fileInput = field.querySelector("[data-upload-input]") as HTMLInputElement | null;
    const urlInput = field.querySelector("[data-upload-url]") as HTMLInputElement | null;
    const previewWrap = field.querySelector("[data-upload-preview-wrap]") as HTMLElement | null;
    const previewImg = field.querySelector("[data-upload-preview]") as HTMLImageElement | null;
    const labelText = field.querySelector("[data-upload-label-text]") as HTMLElement | null;
    const errorEl = field.querySelector("[data-upload-error]") as HTMLElement | null;

    fileInput?.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      if (labelText) labelText.textContent = "Subiendo…";
      if (errorEl) { errorEl.textContent = ""; errorEl.classList.add("hidden"); }

      const formData = new FormData();
      formData.append("file", file);

      try {
        const res = await fetch(endpoint, { method: "POST", body: formData });
        const data = await res.json();

        if (!res.ok || !data.url) {
          throw new Error(data.error ?? "Error al subir la imagen.");
        }

        if (urlInput) urlInput.value = data.url;
        if (previewImg) { previewImg.src = data.url; previewImg.alt = file.name; }
        if (previewWrap) previewWrap.classList.remove("hidden");
        if (labelText) labelText.textContent = "Cambiar imagen";
      } catch (err: any) {
        if (errorEl) { errorEl.textContent = err.message ?? "Error al subir."; errorEl.classList.remove("hidden"); }
        if (labelText) labelText.textContent = "Reintentar";
      }
    });
  });
</script>
