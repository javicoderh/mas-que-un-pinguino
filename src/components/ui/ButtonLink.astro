---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary" | "ghost" | "pink";
  target?: "_self" | "_blank";
  rel?: string;
  download?: boolean | string;
  class?: string;
}

const {
  href,
  label,
  variant = "primary",
  target = "_self",
  rel,
  download,
  class: className = ""
} = Astro.props;

const variants = {
  primary:
    "border-black/45 bg-campaign-warm text-black hover:bg-[#FFF1A8] shadow-[0_18px_60px_rgba(255,232,139,0.25),inset_0_1px_0_rgba(255,255,255,0.35)]",
  secondary:
    "bg-transparent text-white hover:bg-white/10 border-white/20",
  pink:
    "border-campaign-pink bg-campaign-pink text-[color:var(--campaign-bg)] hover:bg-campaign-blush shadow-[0_18px_60px_rgba(255,162,209,0.28)]",
  ghost:
    "bg-white/5 text-campaign-text-muted hover:bg-white/10 border-white/10"
}[variant];
---

<a
  href={href}
  target={target}
  rel={rel ?? (target === "_blank" ? "noreferrer noopener" : undefined)}
  download={download}
  class:list={[
    "focus-ring inline-flex min-h-12 items-center justify-center rounded-full border px-6 py-3 text-[0.95rem] font-extrabold tracking-[0.08em] uppercase transition duration-200",
    variants,
    className
  ]}
>
  {label}
</a>
