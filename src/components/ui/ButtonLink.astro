---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary" | "ghost" | "pink";
  target?: "_self" | "_blank";
  rel?: string;
  download?: boolean | string;
  class?: string;
  analyticsEvent?: string;
  analyticsContext?: string;
}

const {
  href,
  label,
  variant = "primary",
  target = "_self",
  rel,
  download,
  class: className = "",
  analyticsEvent,
  analyticsContext
} = Astro.props;

const variants = {
  primary:
    "border-black/55 bg-campaign-sky text-white hover:bg-[#63C6FF] shadow-[0_18px_60px_rgba(56,182,255,0.3),inset_0_1px_0_rgba(255,255,255,0.24)]",
  secondary:
    "border-black/45 bg-campaign-sky/18 text-white hover:bg-campaign-sky/28",
  pink:
    "border-black/55 bg-campaign-sky text-white hover:bg-[#63C6FF] shadow-[0_18px_60px_rgba(56,182,255,0.3),inset_0_1px_0_rgba(255,255,255,0.24)]",
  ghost:
    "border-black/35 bg-campaign-sky/12 text-white hover:bg-campaign-sky/22"
}[variant];
---

<a
  href={href}
  target={target}
  rel={rel ?? (target === "_blank" ? "noreferrer noopener" : undefined)}
  download={download}
  data-analytics-event={analyticsEvent}
  data-analytics-label={label}
  data-analytics-context={analyticsContext}
  class:list={[
    "focus-ring button-text-outline inline-flex min-h-12 items-center justify-center rounded-full border px-6 py-3 text-[0.95rem] font-extrabold tracking-[0.08em] uppercase transition duration-200",
    variants,
    className
  ]}
>
  {label}
</a>
