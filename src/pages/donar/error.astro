---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  path="/donar/error"
  title="Error en el pago | Salvemos Humboldt"
  description="Hubo un problema procesando tu donación. No se realizó ningún cargo."
>
  <div class="flex min-h-[65vh] items-center justify-center px-5 py-20">
    <div class="max-w-lg text-center">
      <div
        class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full border border-red-400/30 bg-red-400/10"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-10 w-10 fill-red-400">
          <path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
          />
        </svg>
      </div>

      <h1 class="text-3xl font-black text-white md:text-4xl">El pago no se completó</h1>
      <p class="mt-4 text-base leading-7 text-campaign-text-muted">
        Hubo un problema al procesar tu donación. No se realizó ningún cargo. Puedes intentarlo
        nuevamente cuando quieras.
      </p>

      <div class="mt-8">
        <a
          href="/#donar"
          class="focus-ring button-text-outline inline-flex min-h-12 items-center justify-center rounded-full border border-black/55 bg-campaign-sky px-6 py-3 text-sm font-black uppercase tracking-[0.08em] text-white shadow-[0_18px_60px_rgba(56,182,255,0.3),inset_0_1px_0_rgba(255,255,255,0.24)] transition hover:bg-[#63C6FF]"
        >
          Intentar nuevamente
        </a>
      </div>
    </div>
  </div>
</MainLayout>
