---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  path="/donar/gracias"
  title="¡Gracias por tu donación! | Salvemos Humboldt"
  description="Tu donación está siendo procesada. Gracias por apoyar al pingüino de Humboldt."
>
  <div class="flex min-h-[65vh] items-center justify-center px-5 py-20">
    <div class="max-w-lg text-center">
      <div
        class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full border border-campaign-warm/30 bg-campaign-warm/10"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-10 w-10 fill-campaign-warm">
          <path
            d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"
          />
        </svg>
      </div>

      <h1 class="text-3xl font-black text-white md:text-4xl">¡Gracias por tu donación!</h1>
      <p class="mt-4 text-base leading-7 text-campaign-text-muted">
        Tu aporte es fundamental para la defensa del pingüino de Humboldt. En breve recibirás el
        comprobante de pago en tu correo.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href="/"
          class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full border border-campaign-sky/30 bg-campaign-sky/12 px-6 py-3 text-sm font-semibold text-campaign-sky transition hover:bg-campaign-sky/20"
        >
          Volver al inicio
        </a>
        <a
          href="/firma"
          class="focus-ring button-text-outline inline-flex min-h-12 items-center justify-center rounded-full border border-black/55 bg-campaign-sky px-6 py-3 text-sm font-black uppercase tracking-[0.08em] text-white shadow-[0_18px_60px_rgba(56,182,255,0.3),inset_0_1px_0_rgba(255,255,255,0.24)] transition hover:bg-[#63C6FF]"
        >
          También firma la carta
        </a>
      </div>
    </div>
  </div>
</MainLayout>
