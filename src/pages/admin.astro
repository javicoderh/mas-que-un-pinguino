---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import { getAdminSessionFromCookies } from "../lib/security/admin-auth";
import { listApprovedEvents, listEventSubmissions } from "../lib/security/events-storage";
import { chileRegions } from "../lib/events/chile-regions";
import { listFlaggedSignatures } from "../lib/security/storage";
import { listNews } from "../lib/security/news-storage";
import { isSecurityConfigured, isServerStorageConfigured } from "../lib/security/config";
import { listDonations } from "../lib/db/donations-queries";
import { isPostgresAvailable } from "../lib/db/postgres";

export const prerender = false;

const breadcrumbItems = [
  { name: "Inicio", path: "/" },
  { name: "Admin", path: "/admin" }
];

const session = await getAdminSessionFromCookies(Astro.cookies);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1"));
const pageSize = 20;

// --- Donations filter params ---
const dPeriod = Astro.url.searchParams.get("d_period") ?? "month";
const dSearch = (Astro.url.searchParams.get("d_search") ?? "").trim();
const dDateFrom = Astro.url.searchParams.get("d_from") ?? "";
const dDateTo = Astro.url.searchParams.get("d_to") ?? "";
const dPage = Math.max(1, Number(Astro.url.searchParams.get("d_page") ?? "1"));
const dPageSize = 25;

function periodToRange(period: string, customFrom: string, customTo: string): { fromMs?: number; toMs?: number } {
  const now = Date.now();
  if (period === "day")   return { fromMs: now - 86_400_000 };
  if (period === "week")  return { fromMs: now - 7 * 86_400_000 };
  if (period === "month") return { fromMs: now - 30 * 86_400_000 };
  if (period === "year")  return { fromMs: now - 365 * 86_400_000 };
  if (period === "custom") {
    const from = customFrom ? new Date(customFrom).getTime() : undefined;
    const to   = customTo   ? new Date(customTo).getTime() + 86_399_999 : undefined;
    return { fromMs: from, toMs: to };
  }
  return {}; // "all"
}

const { fromMs: dFromMs, toMs: dToMs } = periodToRange(dPeriod, dDateFrom, dDateTo);

const donationsResult = session && isPostgresAvailable
  ? await listDonations({ fromMs: dFromMs, toMs: dToMs, search: dSearch || undefined, page: dPage, pageSize: dPageSize }).catch(() => null)
  : null;

const pendingEvents = session && isServerStorageConfigured ? await listEventSubmissions("pending", page, pageSize) : [];
const flaggedEvents = session && isServerStorageConfigured ? await listEventSubmissions("flagged", page, pageSize) : [];
const approvedEvents = session && isServerStorageConfigured ? await listApprovedEvents() : [];
const flaggedSignatures = session && isServerStorageConfigured ? await listFlaggedSignatures(page, pageSize) : [];
const newsItems = session && isServerStorageConfigured ? await listNews() : [];

const error = Astro.url.searchParams.get("error");
const review = Astro.url.searchParams.get("review");
const deleted = Astro.url.searchParams.get("delete");
const signatureReview = Astro.url.searchParams.get("signature_review");
const passwordChanged = Astro.url.searchParams.get("password_changed");
const newsAction = Astro.url.searchParams.get("news");
const eventUpdate = Astro.url.searchParams.get("event_update");
const formatAdminDateTime = (value: number) =>
  new Intl.DateTimeFormat("es-CL", {
    dateStyle: "short",
    timeStyle: "short",
    timeZone: "America/Santiago"
  }).format(new Date(value));

const fmtMoney = (amount: number, currency: string) =>
  currency === "USD"
    ? `US$${amount}`
    : `$${new Intl.NumberFormat("es-CL").format(amount)} CLP`;

const STATUS_LABELS: Record<string, { label: string; color: string }> = {
  paid:      { label: "Pagado",    color: "text-green-400 bg-green-400/12 border-green-400/30" },
  pending:   { label: "Pendiente", color: "text-campaign-warm bg-campaign-warm/10 border-campaign-warm/30" },
  rejected:  { label: "Rechazado", color: "text-red-400 bg-red-400/10 border-red-400/30" },
  cancelled: { label: "Cancelado", color: "text-white/45 bg-white/5 border-white/12" },
};

const PERIOD_LABELS: Record<string, string> = {
  day: "Hoy", week: "7 días", month: "30 días", year: "365 días", custom: "Rango", all: "Todo"
};
---

<MainLayout
  path="/admin"
  title="Admin de eventos | Es más que un pingüino"
  description="Panel de revisión de propuestas de eventos del sitio."
  hideFloatingCta={true}
  robots="noindex,nofollow,noarchive"
>
  <Section size="compact">
    <Breadcrumbs items={breadcrumbItems} />
    <SectionHeading
      eyebrow="Admin"
      title="Moderación del mapa de eventos"
      body="Este panel concentra las propuestas de eventos pendientes de revisión. Desde aquí puedes aprobar o rechazar cada solicitud antes de que aparezca como marcador en el mapa público."
      as="h1"
    />
  </Section>

  <Section class="pt-0">
    {!isSecurityConfigured || !isServerStorageConfigured ? (
      <div class="surface-panel rounded-[2rem] p-8">
        <p class="text-lg font-semibold text-white">Falta configuración server-side</p>
        <p class="mt-4 text-base leading-7 text-campaign-text-muted">
          Para habilitar el panel admin se necesitan `SECURITY_HASH_SECRET` y credenciales server-side válidas de Firestore.
        </p>
      </div>
    ) : !session ? (
      <div class="mx-auto max-w-xl surface-panel rounded-[2rem] p-8 md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-sky">Acceso</p>
        <h2 class="mt-3 text-3xl font-black text-white">Iniciar sesión</h2>
        <p class="mt-4 text-base leading-7 text-campaign-text-muted">
          Usa la cuenta administradora para revisar y moderar propuestas antes de publicarlas.
        </p>
        {error && (
          <p class="mt-5 rounded-2xl border border-campaign-sky/25 bg-campaign-sky/8 px-4 py-3 text-sm text-campaign-sky">
            {error}
          </p>
        )}
        <form method="post" action="/api/admin/login" class="mt-8 grid gap-5">
          <label class="grid gap-2 text-sm font-medium text-white">
            <span>Usuario</span>
            <input name="username" class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white" required />
          </label>
          <label class="grid gap-2 text-sm font-medium text-white">
            <span>Contraseña</span>
            <input type="password" name="password" class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white" required />
          </label>
          <button
            type="submit"
            class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full border border-black/45 bg-campaign-warm px-6 py-3 text-[0.95rem] font-extrabold uppercase tracking-[0.08em] text-black shadow-[0_18px_60px_rgba(255,232,139,0.25),inset_0_1px_0_rgba(255,255,255,0.35)] transition hover:bg-[#FFF1A8]"
          >
            Entrar
          </button>
        </form>
      </div>
    ) : (
      <div class="grid gap-6">
        <div class="flex flex-wrap items-center justify-between gap-4 surface-panel rounded-[1.75rem] p-6">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-warm">Sesión activa</p>
            <p class="mt-2 text-xl font-bold text-white">{session.username}</p>
            <p class="mt-2 text-sm leading-6 text-campaign-text-muted">
              Pendientes: {pendingEvents.length} · Marcadas: {flaggedEvents.length} · Publicadas: {approvedEvents.length} · Pingüinoticias: {newsItems.length} · Firmas sospechosas: {flaggedSignatures.length}
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href={`/api/admin/export-signatures?status=accepted`}
              class="focus-ring rounded-full border border-white/16 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              Exportar CSV
            </a>
            <form method="post" action="/api/admin/logout">
              <button type="submit" class="focus-ring rounded-full border border-white/16 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
                Cerrar sesión
              </button>
            </form>
          </div>
        </div>

        {review === "ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            La revisión del evento se guardó correctamente.
          </p>
        )}
        {signatureReview === "ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            La firma fue revisada correctamente.
          </p>
        )}
        {deleted === "ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            El evento fue eliminado correctamente.
          </p>
        )}
        {eventUpdate === "ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            El evento se actualizó correctamente.
          </p>
        )}
        {passwordChanged === "ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            Contraseña cambiada correctamente.
          </p>
        )}
        {newsAction === "create_ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            La Pingüinoticia fue creada correctamente.
          </p>
        )}
        {newsAction === "update_ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            La Pingüinoticia fue actualizada correctamente.
          </p>
        )}
        {newsAction === "delete_ok" && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/10 px-4 py-3 text-sm text-white">
            La Pingüinoticia fue eliminada correctamente.
          </p>
        )}
        {error && (
          <p class="rounded-2xl border border-campaign-sky/25 bg-campaign-sky/8 px-4 py-3 text-sm text-campaign-sky">
            {error}
          </p>
        )}

        {/* Pagination controls */}
        <div class="flex items-center gap-4">
          {page > 1 && (
            <a href={`/admin?page=${page - 1}`} class="focus-ring rounded-full border border-white/16 bg-white/5 px-5 py-2 text-sm font-semibold text-white transition hover:bg-white/10">
              ← Anterior
            </a>
          )}
          <span class="text-sm text-campaign-text-muted">Página {page}</span>
          {(pendingEvents.length === pageSize || flaggedEvents.length === pageSize || flaggedSignatures.length === pageSize) && (
            <a href={`/admin?page=${page + 1}`} class="focus-ring rounded-full border border-white/16 bg-white/5 px-5 py-2 text-sm font-semibold text-white transition hover:bg-white/10">
              Siguiente →
            </a>
          )}
        </div>

        {/* ── Donaciones ── */}
        <div class="surface-panel rounded-[1.75rem] p-6">
          <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-warm">Donaciones</p>
              <h2 class="mt-2 text-2xl font-black text-white">Registro de pagos</h2>
            </div>
            {donationsResult && (
              <div class="flex flex-wrap gap-3">
                <div class="rounded-2xl border border-white/12 bg-white/5 px-4 py-3 text-center">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-campaign-sky">Pagados CLP</p>
                  <p class="mt-1 text-lg font-black text-white">{fmtMoney(donationsResult.stats.total_clp, "CLP")}</p>
                </div>
                <div class="rounded-2xl border border-white/12 bg-white/5 px-4 py-3 text-center">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-campaign-sky">Pagados USD</p>
                  <p class="mt-1 text-lg font-black text-white">{fmtMoney(donationsResult.stats.total_usd, "USD")}</p>
                </div>
                <div class="rounded-2xl border border-white/12 bg-white/5 px-4 py-3 text-center">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-campaign-sky">N° pagos</p>
                  <p class="mt-1 text-lg font-black text-white">{donationsResult.stats.paid_count}</p>
                </div>
                {donationsResult.stats.missing_receipt_count > 0 && (
                  <div class="rounded-2xl border border-red-400/30 bg-red-400/10 px-4 py-3 text-center">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-red-400">Sin comprobante</p>
                    <p class="mt-1 text-lg font-black text-red-400">{donationsResult.stats.missing_receipt_count}</p>
                  </div>
                )}
              </div>
            )}
          </div>

          {/* Filtros */}
          <form method="get" action="/admin" class="mb-5 grid gap-3">
            {/* Preservar otros params del admin que no son de donaciones */}
            {page > 1 && <input type="hidden" name="page" value={page} />}

            <div class="flex flex-wrap gap-2">
              {(["day","week","month","year","all","custom"] as const).map((p) => (
                <a
                  href={`/admin?d_period=${p}${dSearch ? `&d_search=${encodeURIComponent(dSearch)}` : ""}`}
                  class:list={[
                    "rounded-full border px-4 py-2 text-xs font-semibold transition",
                    dPeriod === p
                      ? "border-campaign-sky/50 bg-campaign-sky/15 text-campaign-sky"
                      : "border-white/12 bg-white/5 text-white/60 hover:text-white"
                  ]}
                >
                  {PERIOD_LABELS[p]}
                </a>
              ))}
            </div>

            {dPeriod === "custom" && (
              <div class="flex flex-wrap items-center gap-3">
                <input
                  type="date"
                  name="d_from"
                  value={dDateFrom}
                  class="focus-ring rounded-2xl border border-white/14 bg-white/6 px-4 py-2.5 text-sm text-white"
                />
                <span class="text-sm text-white/45">→</span>
                <input
                  type="date"
                  name="d_to"
                  value={dDateTo}
                  class="focus-ring rounded-2xl border border-white/14 bg-white/6 px-4 py-2.5 text-sm text-white"
                />
                <input type="hidden" name="d_period" value="custom" />
                <button type="submit" class="focus-ring rounded-full border border-campaign-sky/30 bg-campaign-sky/12 px-4 py-2 text-xs font-semibold text-campaign-sky transition hover:bg-campaign-sky/20">
                  Aplicar
                </button>
              </div>
            )}

            <div class="flex gap-2">
              <input
                type="text"
                name="d_search"
                value={dSearch}
                placeholder="Buscar por nombre, email, comprobante o N° orden…"
                class="focus-ring w-full max-w-sm rounded-2xl border border-white/14 bg-white/6 px-4 py-2.5 text-sm text-white placeholder:text-white/35"
              />
              <input type="hidden" name="d_period" value={dPeriod} />
              {dDateFrom && <input type="hidden" name="d_from" value={dDateFrom} />}
              {dDateTo   && <input type="hidden" name="d_to"   value={dDateTo} />}
              <button type="submit" class="focus-ring rounded-2xl border border-white/14 bg-white/6 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10">
                Buscar
              </button>
              {dSearch && (
                <a href={`/admin?d_period=${dPeriod}`} class="focus-ring rounded-2xl border border-white/12 bg-white/4 px-4 py-2.5 text-sm text-white/50 transition hover:text-white">
                  ✕
                </a>
              )}
            </div>
          </form>

          {/* Tabla */}
          {!donationsResult ? (
            <p class="text-sm text-campaign-text-muted">Base de datos no disponible.</p>
          ) : donationsResult.rows.length === 0 ? (
            <p class="text-sm text-campaign-text-muted">No hay donaciones para este período{dSearch ? " con ese filtro" : ""}.</p>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead>
                  <tr class="border-b border-white/10 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/45">
                    <th class="pb-3 pr-4 whitespace-nowrap">Fecha</th>
                    <th class="pb-3 pr-4">Donante</th>
                    <th class="pb-3 pr-4">Email</th>
                    <th class="pb-3 pr-4">Monto</th>
                    <th class="pb-3 pr-4">Estado</th>
                    <th class="pb-3 pr-4">Comprobante</th>
                    <th class="pb-3 pr-4 whitespace-nowrap">N° Orden Flow</th>
                    <th class="pb-3">Idioma</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/6">
                  {donationsResult.rows.map((don) => {
                    const st = STATUS_LABELS[don.status] ?? { label: don.status, color: "text-white/45 bg-white/5 border-white/12" };
                    const isPaidNoReceipt = don.status === "paid" && !don.receipt_number;
                    return (
                      <tr class={isPaidNoReceipt ? "bg-red-400/4" : ""}>
                        <td class="py-3 pr-4 whitespace-nowrap text-xs text-white/55">
                          {formatAdminDateTime(don.created_at_ms)}
                        </td>
                        <td class="py-3 pr-4 font-medium text-white max-w-[140px] truncate" title={don.donor_name}>
                          {don.donor_name}
                        </td>
                        <td class="py-3 pr-4 text-xs text-white/70 max-w-[160px] truncate" title={don.email}>
                          {don.email}
                        </td>
                        <td class="py-3 pr-4 font-black text-white whitespace-nowrap">
                          {fmtMoney(don.amount, don.currency)}
                        </td>
                        <td class="py-3 pr-4">
                          <span class={`inline-block rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${st.color}`}>
                            {st.label}
                          </span>
                        </td>
                        <td class="py-3 pr-4">
                          {don.receipt_number ? (
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-green-400/30 bg-green-400/10 px-2.5 py-0.5 text-[11px] font-semibold text-green-400">
                              <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3 w-3 fill-current"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
                              {don.receipt_number}
                            </span>
                          ) : don.status === "paid" ? (
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-red-400/30 bg-red-400/10 px-2.5 py-0.5 text-[11px] font-semibold text-red-400">
                              <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3 w-3 fill-current"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/></svg>
                              Ausente
                            </span>
                          ) : (
                            <span class="text-xs text-white/25">—</span>
                          )}
                        </td>
                        <td class="py-3 pr-4 text-xs font-mono text-white/55">
                          {don.flow_order ?? "—"}
                        </td>
                        <td class="py-3 text-xs text-white/45 uppercase tracking-wide">
                          {don.language}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}

          {/* Paginación de donaciones */}
          {donationsResult && donationsResult.total_rows > dPageSize && (
            <div class="mt-5 flex items-center gap-4">
              {dPage > 1 && (
                <a
                  href={`/admin?d_period=${dPeriod}&d_page=${dPage - 1}${dSearch ? `&d_search=${encodeURIComponent(dSearch)}` : ""}${dDateFrom ? `&d_from=${dDateFrom}` : ""}${dDateTo ? `&d_to=${dDateTo}` : ""}`}
                  class="focus-ring rounded-full border border-white/16 bg-white/5 px-5 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
                >
                  ← Anterior
                </a>
              )}
              <span class="text-sm text-campaign-text-muted">
                Página {dPage} · {donationsResult.total_rows} resultado{donationsResult.total_rows !== 1 ? "s" : ""}
              </span>
              {dPage * dPageSize < donationsResult.total_rows && (
                <a
                  href={`/admin?d_period=${dPeriod}&d_page=${dPage + 1}${dSearch ? `&d_search=${encodeURIComponent(dSearch)}` : ""}${dDateFrom ? `&d_from=${dDateFrom}` : ""}${dDateTo ? `&d_to=${dDateTo}` : ""}`}
                  class="focus-ring rounded-full border border-white/16 bg-white/5 px-5 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
                >
                  Siguiente →
                </a>
              )}
            </div>
          )}
        </div>

        {/* Pingüinoticias */}
        <div class="surface-panel rounded-[1.75rem] p-6">
          <div class="grid gap-6 xl:grid-cols-[0.9fr_1.1fr]">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-sky">Pingüinoticias</p>
              <h2 class="mt-3 text-2xl font-black text-white">Crear nueva publicación</h2>
              <p class="mt-4 text-sm leading-7 text-campaign-text-muted">
                Cada noticia guarda automáticamente su fecha y hora de ingreso. La preferencia se inicializa en `0` y luego puede editarse desde la tabla.
              </p>
            </div>
            <form method="post" action="/api/admin/create-news" class="grid gap-4">
              <label class="grid gap-2 text-sm font-medium text-white">
                <span>Título</span>
                <input
                  name="title"
                  required
                  class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                />
              </label>
              <label class="grid gap-2 text-sm font-medium text-white">
                <span>Contenido</span>
                <textarea
                  name="body"
                  rows="5"
                  required
                  class="focus-ring rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                ></textarea>
              </label>
              <label class="grid gap-2 text-sm font-medium text-white">
                <span>Enlace <span class="text-campaign-text-muted font-normal">(opcional)</span></span>
                <input
                  name="link"
                  type="url"
                  placeholder="https://..."
                  class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
                />
              </label>
              <label class="grid gap-2 text-sm font-medium text-white">
                <span>URL de imagen <span class="text-campaign-text-muted font-normal">(opcional)</span></span>
                <input
                  name="image_url"
                  type="url"
                  placeholder="https://..."
                  class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
                />
              </label>
              <div>
                <button type="submit" class="focus-ring rounded-full border border-black/45 bg-campaign-warm px-5 py-3 text-sm font-extrabold uppercase tracking-[0.08em] text-black transition hover:bg-[#FFF1A8]">
                  Crear Pingüinoticia
                </button>
              </div>
            </form>
          </div>
        </div>

        <div class="surface-panel rounded-[1.75rem] p-6">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-sky">Tabla de noticias</p>
              <h2 class="mt-2 text-2xl font-black text-white">CRUD de Pingüinoticias</h2>
            </div>
            <p class="max-w-xl text-sm leading-6 text-campaign-text-muted">
              El orden público se mantiene por fecha y hora de ingreso. La columna `preferencia` es editable para gestión interna.
            </p>
          </div>

          <div class="mt-6 grid gap-4">
            {newsItems.length > 0 ? (
              newsItems.map((item) => (
                <article class="rounded-[1.5rem] border border-white/12 bg-white/5 p-5">
                  <form method="post" action="/api/admin/update-news" class="grid gap-4">
                    <input type="hidden" name="news_id" value={item.id} />
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-campaign-warm">
                        Ingresada: {formatAdminDateTime(item.createdAtMs)}
                      </p>
                      <label class="flex items-center gap-3 text-sm font-medium text-white">
                        <span>Preferencia</span>
                        <input
                          type="number"
                          name="preference"
                          min="0"
                          value={item.preference}
                          class="focus-ring w-24 rounded-2xl border border-white/14 bg-white/6 px-3 py-2 text-white"
                        />
                      </label>
                    </div>
                    <label class="grid gap-2 text-sm font-medium text-white">
                      <span>Título</span>
                      <input
                        name="title"
                        required
                        value={item.title}
                        class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                      />
                    </label>
                    <label class="grid gap-2 text-sm font-medium text-white">
                      <span>Contenido</span>
                      <textarea
                        name="body"
                        rows="5"
                        required
                        class="focus-ring rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                      >{item.body}</textarea>
                    </label>
                    <label class="grid gap-2 text-sm font-medium text-white">
                      <span>Enlace <span class="text-campaign-text-muted font-normal">(opcional)</span></span>
                      <input
                        name="link"
                        type="url"
                        value={item.link}
                        placeholder="https://..."
                        class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
                      />
                    </label>
                    <label class="grid gap-2 text-sm font-medium text-white">
                      <span>URL de imagen <span class="text-campaign-text-muted font-normal">(opcional)</span></span>
                      <input
                        name="image_url"
                        type="url"
                        value={item.imageUrl}
                        placeholder="https://..."
                        class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
                      />
                    </label>
                    <div class="flex flex-wrap gap-3">
                      <button type="submit" class="focus-ring rounded-full border border-black/45 bg-campaign-warm px-5 py-3 text-sm font-extrabold uppercase tracking-[0.08em] text-black transition hover:bg-[#FFF1A8]">
                        Guardar cambios
                      </button>
                    </div>
                  </form>
                  <form method="post" action="/api/admin/delete-news" class="mt-3">
                    <input type="hidden" name="news_id" value={item.id} />
                    <button type="submit" class="focus-ring rounded-full border border-campaign-sky/30 bg-campaign-sky/10 px-5 py-3 text-sm font-semibold text-campaign-sky transition hover:bg-campaign-sky/18">
                      Borrar Pingüinoticia
                    </button>
                  </form>
                </article>
              ))
            ) : (
              <div class="rounded-[1.5rem] border border-white/12 bg-white/5 p-5">
                <p class="text-base leading-7 text-campaign-text-muted">Todavía no hay Pingüinoticias registradas.</p>
              </div>
            )}
          </div>
        </div>

        {/* Firmas pendientes de revisión */}
        {flaggedSignatures.length > 0 && (
          <div class="space-y-4">
            <h2 class="text-2xl font-black text-white">Firmas pendientes de revisión</h2>
            <div class="overflow-x-auto surface-panel rounded-[1.75rem] p-5">
              <table class="w-full text-sm text-left text-campaign-text-muted">
                <thead class="text-xs uppercase tracking-[0.14em] text-white/60">
                  <tr>
                    <th class="py-2 pr-4">Nombre</th>
                    <th class="py-2 pr-4">País</th>
                    <th class="py-2 pr-4">Región</th>
                    <th class="py-2 pr-4">Score</th>
                    <th class="py-2 pr-4">Razones</th>
                    <th class="py-2 pr-4">Fecha</th>
                    <th class="py-2">Acción</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/8">
                  {flaggedSignatures.map((sig) => (
                    <tr>
                      <td class="py-3 pr-4 text-white font-medium">{sig.fullName}</td>
                      <td class="py-3 pr-4">{sig.country}</td>
                      <td class="py-3 pr-4">{sig.region}</td>
                      <td class="py-3 pr-4">{sig.riskScore}</td>
                      <td class="py-3 pr-4 text-xs">{(sig.riskReasons ?? []).join(", ")}</td>
                      <td class="py-3 pr-4 text-xs">{sig.createdAtMs ? new Date(sig.createdAtMs).toLocaleDateString("es-CL") : "—"}</td>
                      <td class="py-3">
                        <div class="flex gap-2">
                          <form method="post" action="/api/admin/review-signature">
                            <input type="hidden" name="signature_id" value={sig.id} />
                            <input type="hidden" name="decision" value="accepted" />
                            <button type="submit" class="focus-ring rounded-full border border-black/45 bg-campaign-warm px-3 py-1.5 text-xs font-extrabold uppercase text-black transition hover:bg-[#FFF1A8]">
                              Aceptar
                            </button>
                          </form>
                          <form method="post" action="/api/admin/review-signature">
                            <input type="hidden" name="signature_id" value={sig.id} />
                            <input type="hidden" name="decision" value="rejected" />
                            <button type="submit" class="focus-ring rounded-full border border-campaign-sky/30 bg-campaign-sky/10 px-3 py-1.5 text-xs font-semibold text-campaign-sky transition hover:bg-campaign-sky/18">
                              Rechazar
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <div class="grid gap-8 xl:grid-cols-[1fr_1fr]">
          <div class="space-y-4">
            <h2 class="text-2xl font-black text-white">Pendientes y marcadas</h2>
            {[...pendingEvents, ...flaggedEvents].length > 0 ? (
              [...pendingEvents, ...flaggedEvents].map((event) => (
                <article class="surface-panel rounded-[1.75rem] p-5">
                  <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-campaign-warm">
                        {event.status === "flagged" ? "Revisión reforzada" : "Pendiente"}
                      </p>
                      <h3 class="mt-2 text-xl font-bold text-white">{event.title}</h3>
                      <p class="mt-2 text-sm leading-6 text-campaign-text-muted">
                        {event.region} · {event.date} · {event.time}
                      </p>
                      <p class="mt-1 text-sm leading-6 text-campaign-text-muted">{event.venue}</p>
                    </div>
                    <img src={event.imageUrl} alt={event.title} class="h-20 w-28 rounded-2xl object-cover" />
                  </div>
                  <p class="mt-4 text-sm leading-7 text-campaign-text-muted">{event.description}</p>
                  <div class="mt-5 flex flex-wrap gap-3">
                    <form method="post" action="/api/admin/review-event">
                      <input type="hidden" name="event_id" value={event.id} />
                      <input type="hidden" name="decision" value="approved" />
                      <button type="submit" class="focus-ring rounded-full border border-black/45 bg-campaign-warm px-5 py-3 text-sm font-extrabold uppercase tracking-[0.08em] text-black transition hover:bg-[#FFF1A8]">
                        Aprobar
                      </button>
                    </form>
                    <form method="post" action="/api/admin/review-event">
                      <input type="hidden" name="event_id" value={event.id} />
                      <input type="hidden" name="decision" value="rejected" />
                      <button type="submit" class="focus-ring rounded-full border border-white/16 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
                        Rechazar
                      </button>
                    </form>
                    <form method="post" action="/api/admin/delete-event">
                      <input type="hidden" name="event_id" value={event.id} />
                      <button type="submit" class="focus-ring rounded-full border border-campaign-sky/30 bg-campaign-sky/10 px-5 py-3 text-sm font-semibold text-campaign-sky transition hover:bg-campaign-sky/18">
                        Borrar
                      </button>
                    </form>
                  </div>
                </article>
              ))
            ) : (
              <div class="surface-panel rounded-[1.75rem] p-6">
                <p class="text-base leading-7 text-campaign-text-muted">No hay propuestas pendientes por ahora.</p>
              </div>
            )}
          </div>

          <div class="space-y-4">
            <h2 class="text-2xl font-black text-white">Eventos aprobados</h2>
            {approvedEvents.length > 0 ? (
              approvedEvents.map((event) => (
                <article class="surface-panel rounded-[1.75rem] p-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-campaign-sky">{event.region}</p>
                  <h3 class="mt-2 text-xl font-bold text-white">{event.title}</h3>
                  <p class="mt-3 text-sm leading-6 text-campaign-text-muted">
                    {event.date} · {event.time} · {event.venue}
                  </p>
                  <form method="post" action="/api/admin/update-event" class="mt-5 grid gap-3">
                    <input type="hidden" name="event_id" value={event.id} />
                    <div class="grid gap-3 sm:grid-cols-2">
                      <label class="grid gap-2 text-sm font-medium text-white sm:col-span-2">
                        <span>Título</span>
                        <input
                          name="title"
                          required
                          value={event.title}
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        />
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white sm:col-span-2">
                        <span>Descripción</span>
                        <textarea
                          name="description"
                          rows="3"
                          required
                          class="focus-ring rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        >{event.description}</textarea>
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white">
                        <span>Fecha</span>
                        <input
                          name="date"
                          type="date"
                          required
                          value={event.date}
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        />
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white">
                        <span>Hora</span>
                        <input
                          name="time"
                          type="time"
                          required
                          value={event.time}
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        />
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white">
                        <span>Región</span>
                        <select
                          name="region"
                          required
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-[#0E1722] px-4 py-3 text-white"
                        >
                          {chileRegions.map((r) => (
                            <option value={r.name} selected={r.name === event.region}>{r.name}</option>
                          ))}
                        </select>
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white">
                        <span>Lugar</span>
                        <input
                          name="venue"
                          required
                          value={event.venue}
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        />
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white sm:col-span-2">
                        <span>URL de la imagen</span>
                        <input
                          name="image_url"
                          type="url"
                          required
                          value={event.imageUrl}
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        />
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white sm:col-span-2">
                        <span>Link <span class="text-campaign-text-muted font-normal">(opcional)</span></span>
                        <input
                          name="link"
                          type="url"
                          value={event.link}
                          placeholder="https://..."
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white placeholder:text-campaign-text-muted"
                        />
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white">
                        <span>Organizador <span class="text-campaign-text-muted font-normal">(opcional)</span></span>
                        <input
                          name="organizer_name"
                          value={event.organizerName}
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        />
                      </label>
                      <label class="grid gap-2 text-sm font-medium text-white">
                        <span>Email organizador <span class="text-campaign-text-muted font-normal">(opcional)</span></span>
                        <input
                          name="organizer_email"
                          type="email"
                          value={event.organizerEmail}
                          class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white"
                        />
                      </label>
                    </div>
                    <div>
                      <button type="submit" class="focus-ring rounded-full border border-black/45 bg-campaign-warm px-5 py-3 text-sm font-extrabold uppercase tracking-[0.08em] text-black transition hover:bg-[#FFF1A8]">
                        Guardar cambios
                      </button>
                    </div>
                  </form>
                  <form method="post" action="/api/admin/delete-event" class="mt-3">
                    <input type="hidden" name="event_id" value={event.id} />
                    <button type="submit" class="focus-ring rounded-full border border-campaign-sky/30 bg-campaign-sky/10 px-5 py-3 text-sm font-semibold text-campaign-sky transition hover:bg-campaign-sky/18">
                      Borrar evento
                    </button>
                  </form>
                </article>
              ))
            ) : (
              <div class="surface-panel rounded-[1.75rem] p-6">
                <p class="text-base leading-7 text-campaign-text-muted">Todavía no hay eventos aprobados en el mapa.</p>
              </div>
            )}
          </div>
        </div>

        {/* Cambiar contraseña */}
        <details class="surface-panel rounded-[1.75rem] p-6">
          <summary class="cursor-pointer text-sm font-semibold uppercase tracking-[0.18em] text-campaign-text-muted hover:text-white">
            Cambiar contraseña
          </summary>
          <form method="post" action="/api/admin/change-password" class="mt-6 grid gap-4 max-w-md">
            <label class="grid gap-2 text-sm font-medium text-white">
              <span>Contraseña actual</span>
              <input type="password" name="current_password" class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white" required />
            </label>
            <label class="grid gap-2 text-sm font-medium text-white">
              <span>Nueva contraseña (mín. 12 caracteres)</span>
              <input type="password" name="new_password" minlength="12" class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white" required />
            </label>
            <label class="grid gap-2 text-sm font-medium text-white">
              <span>Confirmar nueva contraseña</span>
              <input type="password" name="confirm_password" class="focus-ring min-h-12 rounded-2xl border border-white/14 bg-white/6 px-4 py-3 text-white" required />
            </label>
            <button
              type="submit"
              class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full border border-black/45 bg-campaign-warm px-6 py-3 text-[0.95rem] font-extrabold uppercase tracking-[0.08em] text-black transition hover:bg-[#FFF1A8]"
            >
              Cambiar contraseña
            </button>
          </form>
        </details>
      </div>
    )}
  </Section>
</MainLayout>
