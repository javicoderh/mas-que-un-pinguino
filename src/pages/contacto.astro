---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { campaignConfig } from "../content/campaign";

const { socialLinks } = campaignConfig;
const contactLinks = [
  {
    href: socialLinks.find((item) => item.label === "Instagram")?.href ?? "#",
    label: "Instagram",
    tone: "text-campaign-pink",
    path: "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2.2A2.8 2.8 0 0 0 4.2 7v10A2.8 2.8 0 0 0 7 19.8h10a2.8 2.8 0 0 0 2.8-2.8V7A2.8 2.8 0 0 0 17 4.2H7Zm10.75 1.65a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2.2A2.8 2.8 0 1 0 12 14.8 2.8 2.8 0 0 0 12 9.2Z"
  },
  {
    href: socialLinks.find((item) => item.label === "TikTok")?.href ?? "#",
    label: "TikTok",
    tone: "text-white",
    path: "M14 3c.26 2.08 1.42 3.78 3.6 4.07v2.77a6.3 6.3 0 0 1-3.57-1.17v5.14a5.81 5.81 0 1 1-5.02-5.75v2.86a2.94 2.94 0 1 0 2.17 2.84V3H14Z"
  },
  {
    href: "https://wa.me/56997468479",
    label: "WhatsApp",
    tone: "text-emerald-400",
    detail: "+56 9 9746 8479",
    path: "M12 2a9.92 9.92 0 0 0-8.58 14.95L2 22l5.19-1.36A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.08-1.12l-.29-.17-3.08.81.82-3-.19-.31A8 8 0 1 1 12 20Zm4.39-5.61c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.2-.72-.64-1.21-1.43-1.35-1.67-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.79-.2-.47-.41-.4-.56-.4h-.48c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.31.98 2.47c.12.16 1.68 2.56 4.08 3.59.57.25 1.02.39 1.37.5.58.18 1.11.15 1.53.09.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.03.14-1.13-.06-.1-.22-.16-.46-.28Z"
  }
];
---

<MainLayout
  path="/contacto"
  title="Contacto | Es más que un pingüino"
  description="Canales de contacto y redes de la campaña Es más que un pingüino."
  hideFloatingCta={true}
>
  <Section size="compact">
    <SectionHeading
      eyebrow="Contacto"
      title="Conversemos y mantengamos la campaña en movimiento"
      body="Si quieres difundir, coordinar, hacer una consulta o sumarte desde tu territorio, aquí tienes los canales directos de la campaña."
    />
  </Section>

  <Section class="pt-0">
    <div class="mx-auto max-w-5xl">
      <div class="surface-panel rounded-[2rem] p-8 md:p-10">
        <div class="flex flex-wrap items-center justify-center gap-6 md:gap-8">
          {contactLinks.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith("mailto:") ? "_self" : "_blank"}
              rel={item.href.startsWith("mailto:") ? undefined : "noreferrer noopener"}
              aria-label={item.detail ? `${item.label}: ${item.detail}` : item.label}
              title={item.detail ? `${item.label}: ${item.detail}` : item.label}
              class="focus-ring inline-flex items-center justify-center text-center transition hover:-translate-y-0.5"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class={`h-10 w-10 fill-current ${item.tone} drop-shadow-[0_0_6px_rgba(56,182,255,0.95)]`}
              >
                <path d={item.path}></path>
              </svg>
            </a>
          ))}
        </div>

        <div class="mt-8 text-center">
          <div class="flex justify-center text-campaign-sky">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-10 w-10 fill-current">
              <path d="M3 5h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 2v.51l9 5.63 9-5.63V7H3Zm18 10V9.86l-8.47 5.29a1 1 0 0 1-1.06 0L3 9.86V17h18Z"></path>
            </svg>
          </div>
          <a
            href="mailto:mariajose.om@cidemar.org"
            class="focus-ring mt-3 inline-block text-base font-semibold text-white transition hover:text-campaign-warm md:text-lg"
          >
            mariajose.om@cidemar.org
          </a>
        </div>
      </div>
    </div>
  </Section>
</MainLayout>
