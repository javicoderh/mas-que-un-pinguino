---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";

const breadcrumbItems = [
  { name: "Inicio", path: "/" },
  { name: "Ciencia", path: "/ciencia" }
];

const evidenceBlocks = [
  {
    title: "Indicadores ecológicos",
    body:
      "El sitio presenta al pingüino de Humboldt como una especie que ayuda a interpretar cambios en el ecosistema marino y en la disponibilidad de alimento."
  },
  {
    title: "Contexto reciente",
    body:
      "La campaña reúne antecedentes sobre pérdida de individuos, influenza aviar y efectos asociados a cambios oceanográficos para dar contexto a la necesidad de protección."
  },
  {
    title: "Lectura ciudadana de la evidencia",
    body:
      "El contenido busca traducir información científica a un lenguaje claro para que la participación no dependa de dominar tecnicismos."
  }
];

const methodologySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Base científica y metodología pública de la campaña",
  about: ["pingüino de Humboldt", "conservación marina", "participación ciudadana"],
  author: {
    "@type": "Organization",
    name: "Es más que un pingüino"
  }
};
---

<MainLayout
  path="/ciencia"
  title="Ciencia del pingüino de Humboldt | Base y metodología de la campaña"
  description="Revisa la base científica divulgativa del sitio, cómo se traduce la evidencia a lenguaje claro y qué materiales públicos sustentan la campaña."
  keywords={["ciencia pingüino de Humboldt", "base científica", "conservación marina", "metodología", "divulgación científica"]}
  breadcrumbItems={breadcrumbItems}
  pageType="Article"
  schema={methodologySchema}
  publishedTime="2026-04-06T12:00:00-04:00"
  modifiedTime="2026-04-06T12:00:00-04:00"
>
  <Section size="compact">
    <Breadcrumbs items={breadcrumbItems} />
    <SectionHeading
      eyebrow="Base científica"
      title="Cómo se apoya este sitio en ciencia y divulgación responsable"
      body="La intención de esta página es mostrar, con transparencia, cómo la campaña conecta evidencia ecológica, documentos públicos y lenguaje accesible para invitar a una participación mejor informada."
      as="h1"
    />
  </Section>

  <Section class="pt-0">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
      <article class="surface-panel rounded-[2rem] p-8">
        <h2 class="text-2xl font-bold text-white">Qué ofrece esta sección</h2>
        <div class="mt-6 space-y-5">
          {evidenceBlocks.map((block) => (
            <div class="rounded-[1.5rem] border border-white/12 bg-white/5 p-5">
              <h3 class="text-lg font-semibold text-white">{block.title}</h3>
              <p class="mt-3 text-sm leading-7 text-campaign-text-muted">{block.body}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="surface-panel rounded-[2rem] p-8">
        <h2 class="text-2xl font-bold text-white">Materiales públicos del sitio</h2>
        <ul class="mt-6 space-y-4 text-sm leading-7 text-campaign-text-muted">
          <li>La carta abierta como documento central de contexto y propuesta pública.</li>
          <li>La página de transparencia como explicación de principios, metodología y criterios de participación.</li>
          <li>Las páginas temáticas del centro de información para responder intenciones de búsqueda más específicas.</li>
          <li>Las Pingüinoticias para mantener vigencia editorial y registrar hitos con fecha.</li>
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/carta" class="focus-ring rounded-full border border-white/12 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:text-campaign-warm">Carta abierta</a>
          <a href="/transparencia" class="focus-ring rounded-full border border-white/12 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:text-campaign-warm">Transparencia</a>
          <a href="/noticias" class="focus-ring rounded-full border border-white/12 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:text-campaign-warm">Pingüinoticias</a>
        </div>
      </article>
    </div>
  </Section>
</MainLayout>
