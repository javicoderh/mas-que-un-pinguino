---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import EventsChileMap from "../components/campaign/EventsChileMap.astro";
import { listApprovedEvents } from "../lib/security/events-storage";
import { isServerStorageConfigured } from "../lib/security/config";

export const prerender = false;

const breadcrumbItems = [
  { name: "Inicio", path: "/" },
  { name: "Eventos", path: "/eventos" }
];

type ApprovedEvent = Awaited<ReturnType<typeof listApprovedEvents>>;

let approvedEvents: ApprovedEvent = [];

if (isServerStorageConfigured) {
  try {
    approvedEvents = await listApprovedEvents();
  } catch (error) {
    console.error("eventos-page-fallback", error);
  }
}

// Cache at CDN/Edge for 5 minutes; revalidates in background
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=60");
---

<MainLayout
  path="/eventos"
  title="Mapa de eventos por el pingüino de Humboldt | Es más que un pingüino"
  description="Explora eventos aprobados en Chile asociados al pingüino de Humboldt, organizados por región y presentados en un mapa ciudadano del país."
  keywords={["eventos pingüino de Humboldt", "mapa Chile regiones", "actividades ciudadanas", "eventos ambientales"]}
  breadcrumbItems={breadcrumbItems}
  pageType="CollectionPage"
>
  <Section size="compact">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
      <SectionHeading
        eyebrow="Eventos"
        title="Un mapa ciudadano de actividades en torno al pingüino de Humboldt"
        body="Esta sección reúne eventos aprobados por el equipo y los sitúa en un mapa de Chile por regiones. La idea es facilitar la participación territorial sin sacrificar orden, contexto ni calidad de la información publicada."
        as="h1"
      />
      <div class="surface-panel rounded-[1.75rem] p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-sky">Resumen</p>
        <p class="mt-4 text-4xl font-black text-white">{approvedEvents.length}</p>
        <p class="mt-3 text-sm leading-6 text-campaign-text-muted">
          eventos aprobados visibles en el mapa. Cada propuesta nueva pasa antes por revisión manual.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <ButtonLink href="/eventos/proponer" label="Proponer evento" />
          <ButtonLink href="/faq" label="Ver FAQ" variant="secondary" />
        </div>
      </div>
    </div>
  </Section>

  <Section class="pt-0">
    <EventsChileMap events={approvedEvents} />
  </Section>

  <Section class="pt-0">
    <div class="grid gap-6 lg:grid-cols-3">
      <article class="surface-panel rounded-[1.75rem] p-6">
        <h2 class="text-xl font-bold text-white">Moderación previa</h2>
        <p class="mt-4 text-sm leading-7 text-campaign-text-muted">
          Ningún evento aparece automáticamente. Cada propuesta se revisa antes de publicarse para mantener el mapa confiable y coherente con el proyecto.
        </p>
      </article>
      <article class="surface-panel rounded-[1.75rem] p-6">
        <h2 class="text-xl font-bold text-white">Lectura territorial</h2>
        <p class="mt-4 text-sm leading-7 text-campaign-text-muted">
          El mapa organiza la información por regiones para que la ciudadanía entienda mejor dónde están ocurriendo actividades y cómo se distribuyen en el país.
        </p>
      </article>
      <article class="surface-panel rounded-[1.75rem] p-6">
        <h2 class="text-xl font-bold text-white">Participación cuidada</h2>
        <p class="mt-4 text-sm leading-7 text-campaign-text-muted">
          La capa de seguridad reutiliza los mecanismos anti abuso del sitio para reducir spam, automatizaciones y envíos hostiles al formulario.
        </p>
      </article>
    </div>
  </Section>
</MainLayout>
