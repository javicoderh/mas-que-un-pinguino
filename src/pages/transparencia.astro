---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import { campaignConfig } from "../content/campaign";

const { transparency, futureRoutes, knowledgeHub } = campaignConfig;
const letterPdfUrl = campaignConfig.assets.publicLetterPdf;
const breadcrumbItems = [
  { name: "Inicio", path: "/" },
  { name: "Transparencia", path: "/transparencia" }
];
---

<MainLayout
  path="/transparencia"
  title="Transparencia y metodología | Es más que un pingüino"
  description="Principios, base científica, metodología pública y estructura de información de la campaña por la protección del pingüino de Humboldt."
  keywords={["transparencia campaña", "metodología", "base científica", "pingüino de Humboldt", "participación ciudadana"]}
  breadcrumbItems={breadcrumbItems}
  pageType="AboutPage"
>
  <Section size="compact">
    <Breadcrumbs items={breadcrumbItems} />
    <SectionHeading
      eyebrow="Transparencia"
      title={transparency.title}
      body={transparency.body}
      as="h1"
    />
  </Section>

  <Section class="pt-0">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <article class="surface-panel rounded-[2rem] p-8">
        <h2 class="text-2xl font-bold text-white">Principios de la campaña</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {transparency.principles.map((principle) => (
            <li class="rounded-2xl border border-white/12 bg-white/5 px-4 py-3 text-sm text-white">
              {principle}
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-wrap gap-4">
          <ButtonLink href={letterPdfUrl} label="Abrir carta científica" target="_blank" analyticsEvent="document_open" analyticsContext="transparency_page" />
          <ButtonLink href="/firma" label="Firmar la carta" variant="pink" analyticsEvent="cta_click" analyticsContext="transparency_page" />
        </div>
      </article>

      <article class="surface-panel rounded-[2rem] p-8">
        <h2 class="text-2xl font-bold text-white">Arquitectura preparada para crecer</h2>
        <p class="mt-4 text-base leading-7 text-campaign-text-muted">
          Esta base deja rutas y responsabilidades claras para escalar sin rehacer la primera fase.
        </p>
        <ul class="mt-6 space-y-4">
          {futureRoutes.map((item) => (
            <li class="rounded-2xl border border-white/12 bg-black/20 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-campaign-sky">{item.phase}</p>
              <p class="mt-2 text-lg font-semibold text-white">{item.route}</p>
              <p class="mt-2 text-sm leading-6 text-campaign-text-muted">{item.description}</p>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </Section>

  <Section class="pt-0">
    <div class="surface-panel rounded-[2rem] p-8">
      <h2 class="text-2xl font-bold text-white">{transparency.publicReadinessTitle}</h2>
      <p class="mt-4 max-w-3xl text-base leading-7 text-campaign-text-muted">
        {transparency.publicReadinessBody}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        {transparency.publicReadinessLinks.map((item) => (
          <ButtonLink href={item.href} label={item.label} variant="ghost" analyticsEvent="navigation_click" analyticsContext="transparency_public_surface" />
        ))}
      </div>
    </div>
  </Section>

  <Section class="pt-0">
    <div class="surface-panel rounded-[2rem] p-8">
      <h2 class="text-2xl font-bold text-white">Centro de información y fuentes de contexto</h2>
      <p class="mt-4 max-w-3xl text-base leading-7 text-campaign-text-muted">
        Para que el sitio no dependa de una sola landing, se crearon páginas temáticas que amplían contexto, responden preguntas específicas y ayudan a buscadores a entender mejor el alcance editorial del proyecto.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {knowledgeHub.slice(0, 4).map((item) => (
          <a href={item.href} class="rounded-[1.5rem] border border-white/12 bg-white/5 p-5 transition hover:border-white/20">
            <p class="text-lg font-semibold text-white">{item.label}</p>
            <p class="mt-2 text-sm leading-6 text-campaign-text-muted">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </Section>
</MainLayout>
